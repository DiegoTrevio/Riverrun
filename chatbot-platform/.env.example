# ---- Obligatorio ----
POSTGRES_PASSWORD=cambia-esta-clave
# Clave global de Evolution API (inventa una larga y aleatoria)
EVOLUTION_API_KEY=cambia-esta-clave-larga
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Compatibilidad: la clave existente en OPENAI_API_KEY también se acepta.
# Superadministrador inicial del panel (se crea al arrancar; ve todas las cuentas)
ADMIN_USER=tu@correo.com
ADMIN_PASSWORD=cambia-esta-clave
# Al menos 16 caracteres aleatorios (p.ej. `openssl rand -hex 32`)
SESSION_SECRET=

# ---- Modelos de OpenRouter (se pueden cambiar por chatbot en el panel) ----
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SUMMARY_MODEL=openai/gpt-4.1-mini
OPENROUTER_TRANSCRIPTION_MODEL=google/gemini-2.5-flash

# Búsqueda semántica opcional (requiere la extensión pgvector; genera consumo de embeddings)
KNOWLEDGE_SEARCH_ENABLED=false
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Modelos de respaldo (máx. 2, separados por coma): si el principal falla o está saturado, OpenRouter prueba estos en orden.
# Deben soportar salidas estructuradas (JSON Schema). Verifica los nombres en https://openrouter.ai/models; el panel (Sistema)
# avisa si algún modelo configurado deja de existir.
# Con docker compose el respaldo por defecto es google/gemini-2.5-flash; "none" lo desactiva.
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,anthropic/claude-haiku-4.5

# ---- Dominio y HTTPS (docker compose --profile https up -d) ----
# Necesario para Telegram, Messenger, Instagram y el chat web.
DOMAIN=chatbot.tudominio.com
SECURE_COOKIES=true
# PUBLIC_BASE_URL=https://chatbot.tudominio.com   # por defecto https://$DOMAIN

# ---- Autoregistro de empresas (cada cliente crea su cuenta y conecta su WhatsApp solo) ----
SIGNUP_ENABLED=true
# Días de prueba gratis. Con 0 no hay prueba: la cuenta se activa al pagar (requiere cobro en línea, más abajo).
TRIAL_DAYS=14
# Límites de la prueba gratuita (0 = sin límite). Los planes de pago definen los suyos en "Planes y cobro".
TRIAL_MAX_MESSAGES=300
TRIAL_MAX_CHANNELS=2
TRIAL_MAX_USERS=3
TRIAL_MAX_CHATBOTS=2
# Redes sociales conectadas por Zernio (cada cuenta conectada la paga la plataforma).
TRIAL_MAX_SOCIAL_ACCOUNTS=2
# Google Calendar (opcional): credenciales OAuth; ver docs/integraciones.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook / Microsoft 365 (opcional): registro de aplicación en Azure; ver docs/integraciones.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common   (o el id de tu organización para aceptar solo sus cuentas)
# Cada cuántos segundos se revisa el buzón de los canales de correo (mínimo 15)
# EMAIL_POLL_SECONDS=60
# Correo saliente: confirmación de correo, recuperar contraseña y avisos.
# Ejemplos: smtps://usuario:clave@smtp.tuproveedor.com:465   ·   smtp://apikey:SG.xxx@smtp.sendgrid.net:587
SMTP_URL=
MAIL_FROM=Tu Marca <no-responder@tudominio.com>
# Sin SMTP, pon false (si no, nadie podrá confirmar su correo ni conectar WhatsApp)
SIGNUP_REQUIRE_EMAIL=true
# Tú: recibes por correo las cuentas nuevas, pruebas por vencer y gasto alto
SUPERADMIN_EMAIL=tu@correo.com
# Direcciones públicas de tus términos y aviso de privacidad (se enlazan en el registro). Plantillas en docs/legal/
TERMS_URL=
PRIVACY_URL=
# Lo que ven tus clientes para contratar o reactivar (correo, WhatsApp o enlace)
SUPPORT_CONTACT=ventas@tudominio.com
# Aviso (no bloquea) cuando una cuenta pasa este gasto de IA al mes, en USD. 0 = sin aviso
AI_ALERT_USD_PER_ACCOUNT=20

# ---- Opcional ----
# Evolution API: por defecto la versión verificada, fijada por digest en docker-compose.yml (no uses "latest": una
# descarga futura cambiaría la versión sin aviso). Para cambiarla, ponla aquí y aplícala con ./riverrun update
# (respaldo verificado, confirmación y verificación de sesiones). Ver docs/evolution-api.md.
# EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7@sha256:1bd8afc4a6cf48822e6cf02469aeae7bd35a12a6b616eacd1291926307f4d339
# Umbrales de la vigilancia de WhatsApp (heurísticas; ver docs/evolution-api.md → Monitoreo preventivo)
# WHATSAPP_ALERT_DOWN_RATIO=0.5
# WHATSAPP_ALERT_SEND_FAILURES=5
# WHATSAPP_POST_UPDATE_HOURS=24
# Validación de la configuración al arrancar (ver docs/configuracion.md; revisión sin arrancar: npm run config:check).
# strict (por defecto): un problema crítico impide arrancar. warn: arranca igual y lo muestra en el panel (solo emergencias).
# CONFIG_VALIDATION=strict
# Entorno (se deduce de NODE_ENV; la imagen de Docker es production): production | development | test
# RIVERRUN_ENV=production
# TRUST_PROXY_HOPS=1   # 1 con Caddy delante; 0 si expones el backend directamente
# PANEL_BIND=127.0.0.1   # usa 0.0.0.0 para exponer el puerto 3000 sin Caddy (no recomendado)

# ---- Solo para desarrollo local sin Docker ----
# DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
# EVOLUTION_URL=http://localhost:8080
# WEBHOOK_BASE_URL=http://localhost:3000
# PUBLIC_BASE_URL=http://localhost:3000
# UPLOADS_DIR=./data/uploads

# ---- Respaldos (el contenedor "backup" corre solo cada noche; ./riverrun install genera la clave) ----
# Clave que cifra los respaldos. GUÁRDALA FUERA DEL SERVIDOR: sin ella no se pueden restaurar.
BACKUP_PASSPHRASE=
# BACKUP_HOUR=03:30            # hora UTC
# BACKUP_KEEP_DAILY=7  BACKUP_KEEP_WEEKLY=4  BACKUP_KEEP_MONTHLY=6
# Copia en la nube (muy recomendado: si el servidor se pierde, los respaldos locales también). Cualquier almacenamiento tipo S3:
# BACKUP_S3_BUCKET=mi-bucket
# BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com   # B2, R2, Wasabi… (vacío para AWS)
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
# BACKUP_S3_PROVIDER=Other     # AWS | Cloudflare | Wasabi | Other
# BACKUP_MAX_AGE_HOURS=36      # avisa si pasa este tiempo sin un respaldo nuevo

# ---- Cobro automático (opcional; cada proveedor se activa con sus dos claves) ----
# Stripe: Dashboard → Desarrolladores → Claves API / Webhooks. No hace falta crear precios en Stripe: se cobran
# el monto y la moneda de cada plan de "Planes y cobro" (si ya tienes un price_…, puedes pegarlo ahí).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago: Tus integraciones → credenciales de producción / Webhooks (clave secreta).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Días que una cuenta con cobro fallido sigue funcionando antes de pausarse
BILLING_GRACE_DAYS=5

# ---- Monitoreo ----
# URL que se visita cada 5 min mientras todo está sano (healthchecks.io, Uptime Kuma "push"…): si deja de llegar, ellos te avisan
# aunque el servidor entero esté caído.
HEARTBEAT_URL=
# Vigilante: si la cola o las tareas dejan de avanzar (WATCHDOG_STALL_MS, 10 min) o el proceso se bloquea
# (WATCHDOG_BLOCK_MS, 60 s), el proceso se reinicia solo. WATCHDOG=off lo apaga.
# WATCHDOG=on
# Tiempo máximo de una tarea programada antes de cortarla y reintentarla.
# JOB_TIMEOUT_MS=180000
# Además del correo, avisos a un webhook (Slack, Discord, ntfy.sh/tu-tema, Telegram…). Recibe POST con {"text": "..."}.
ALERT_WEBHOOK_URL=
# Token para /health/functional y /metrics (cabecera Authorization: Bearer). Vacío = esos endpoints no existen.
# ./riverrun install y ./riverrun update lo generan solos.
HEALTH_TOKEN=
# Componentes cuyas alertas se registran pero no se envían. Con fecha vence sola: backup=2026-10-12T18:00:00Z,disk
# (sin fecha no vence y el preflight lo advierte; una entrada que no se entiende no silencia nada).
# ALERT_MUTE=
# Minutos que una incidencia puede seguir abierta antes de un aviso de escalamiento.
# ALERT_ESCALATE_MINUTES=60
# Memoria del proceso (MB) a partir de la que se avisa. 0 = sin aviso.
# RESOURCE_WARN_RSS_MB=1024

# ---- Salida de mensajes ----
# live envía de verdad (producción). sandbox (staging, pruebas) bloquea todo envío salvo a los destinos de OUTBOUND_SANDBOX_ALLOW:
# teléfonos, correos o URLs, separados por comas. Un valor distinto de live o sandbox impide arrancar.
# OUTBOUND_MODE=live
# OUTBOUND_SANDBOX_ALLOW=

# Piloto semántico: UUID de cuentas separados por comas; vacío habilita todas si ENABLED=true.
KNOWLEDGE_SEARCH_ACCOUNT_IDS=

# Supervisión en el panel: revisión cada 5 minutos, ventana de una hora.
KNOWLEDGE_MONITOR_ENABLED=true
KNOWLEDGE_ALERT_PENDING_MINUTES=15
KNOWLEDGE_ALERT_FALLBACK_RATIO=0.05
KNOWLEDGE_ALERT_MIN_ATTEMPTS=20
KNOWLEDGE_ALERT_P95_MS=10000
# 0 desactiva solo el umbral de gasto alto; faltas de costo siguen avisándose.
KNOWLEDGE_ALERT_HOURLY_USD=5

# Zernio (API unificada de mensajes). Solo el servidor usa estas variables.
# Redes sociales (Instagram, Facebook, Telegram, X, Bluesky, Reddit, WhatsApp Business) por Zernio.
# Una sola llave para toda la instalación; cada negocio conecta sus redes desde el panel.
# También puedes pegarla en el panel (Sistema → Redes sociales), cifrada y sin reiniciar. Si se define aquí, esta manda.
# ZERNIO_API_KEY=
# ZERNIO_API_URL=https://zernio.com/api/v1
# Llamadas por minuto a Zernio para toda la instalación (se reparten entre procesos). Vacío = según tus cuentas
# conectadas (60, 600 o 1200 por minuto, al 90 %).
# ZERNIO_RATE_PER_MIN=

# Facebook e Instagram con un botón: la app de Meta de la plataforma (Meta for Developers → tu app → Configuración → Básica).
# Con META_APP_ID y META_APP_SECRET cada negocio pulsa «Conectar con Facebook» y elige sus páginas; sin copiar tokens.
# En la app: Inicio de sesión con Facebook → URI de redirección OAuth válida: https://TU_DOMINIO/meta/callback
# Webhooks (objetos Page e Instagram): URL https://TU_DOMINIO/meta/webhook, token = META_VERIFY_TOKEN,
# campos messages, messaging_postbacks y message_echoes. Requiere PUBLIC_BASE_URL con HTTPS.
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# Opcional: configuración de «Facebook Login for Business» (si falta, se piden los permisos uno por uno).
# META_CONFIG_ID=
# META_GRAPH_VERSION=v21.0

# Procesamiento durable PostgreSQL. all mantiene un solo proceso para un VPS pequeño.
# http solo recibe; worker procesa sin escuchar HTTP. Deben compartir DB, configuración y archivos.
PROCESS_ROLE=all
# Inicializa el límite global de worker_limits; para cambiarlo después, ver docs/durable-processing.md.
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_MS=60000
QUEUE_MAX_RETRY_MS=900000
QUEUE_POLL_MS=500
# Pausa operativa global; los perfiles conservan su selección en el panel.
KNOWLEDGE_SEARCH_FORCE_OFF=false
KNOWLEDGE_MIN_SIMILARITY=0.25
# Precio estimado de embeddings por millón de tokens en USD. Vacío: conocido para text-embedding-3-small; desconocido para otros modelos.
EMBEDDING_PRICE_PER_MILLION=
