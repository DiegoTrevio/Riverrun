# ---- Obligatorio ----
POSTGRES_PASSWORD=cambia-esta-clave
# Clave global de Evolution API (inventa una larga y aleatoria)
EVOLUTION_API_KEY=cambia-esta-clave-larga
OPENAI_API_KEY=sk-...
# Acceso al panel
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# Al menos 16 caracteres aleatorios (p.ej. `openssl rand -hex 32`)
SESSION_SECRET=

# ---- Modelos de OpenAI (se pueden cambiar por chatbot en el panel) ----
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# ---- HTTPS con Caddy (docker compose --profile https up -d) ----
# DOMAIN=chatbot.tudominio.com
# SECURE_COOKIES=true

# ---- Opcional ----
# EVOLUTION_IMAGE=evoapicloud/evolution-api:latest
# PANEL_BIND=127.0.0.1   # usa 0.0.0.0 para exponer el puerto 3000 sin Caddy (no recomendado)

# ---- Solo para desarrollo local sin Docker ----
# DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
# EVOLUTION_URL=http://localhost:8080
# WEBHOOK_BASE_URL=http://localhost:3000
# UPLOADS_DIR=./data/uploads
