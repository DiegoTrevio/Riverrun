#!/usr/bin/env bash
# riverrun — instalar, actualizar, respaldar y vigilar la plataforma con un solo comando.
#
#   ./riverrun install     instala todo (genera claves, pregunta lo mínimo, levanta los servicios)
#   ./riverrun install-docker   instala Docker desde su repositorio apt oficial (Debian/Ubuntu, llave verificada; root)
#   ./riverrun update      actualiza con respaldo previo y vuelta atrás automática si algo falla
#                          (si cambia Evolution: compatibilidad, respaldo verificado, confirmación y verificación de sesiones)
#   ./riverrun status      estado de los servicios, salud, último respaldo y si hay versión nueva
#   ./riverrun preflight [--offline]   revisión previa a producción: solo lectura; sin --offline también consulta el servidor y el HTTPS
#   ./riverrun backup      respaldo inmediato (corre solo cada noche)
#   ./riverrun restore [archivo|latest]   restaura un respaldo (en un servidor nuevo: pasa la ruta del archivo)
#   ./riverrun semantic    activa la búsqueda semántica (pgvector) para catálogos grandes
#   ./riverrun logs [servicio]            registros en vivo
#   ./riverrun restart     aplica cambios hechos a .env
#   ./riverrun rotate-secret   cambia SESSION_SECRET (respaldo antes, confirmación, consecuencias avisadas)
#   ./riverrun rotate-data-key cambia DATA_KEY, la llave de los datos cifrados (respaldo antes; nada se desconecta)
#   ./riverrun db-roles    un usuario de PostgreSQL por servicio (lo hacen solos install, update y restore)
#   ./riverrun admin-password [correo]   recupera el acceso del superadministrador: contraseña nueva y sesiones cerradas
#   ./riverrun keys        muestra las llaves que hay que guardar fuera del servidor (solo en una terminal; --stdout)
#   sudo ./riverrun harden firewall (también para lo que publica Docker), SSH solo con llave, fail2ban y actualizaciones
#                          automáticas (Debian, Ubuntu, Fedora, AlmaLinux, Rocky, RHEL; --yes, --skip-firewall, --skip-ssh; HARDEN_ALLOW_PORTS="8080,…")
#
# Opciones de update: --no-backup  --accept-db-image-change  --accept-evolution-change (confirma sin preguntar)
#   --skip-ci-check (solo emergencias: aplica aunque el CI de GitHub no esté en verde)
#   RIVERRUN_OBSERVE_SECONDS  tiempo que la versión nueva se observa antes de dar por buena (120; 0 = no observar)
# Opciones de install (o variables de entorno, para instalar sin preguntas):
#   --non-interactive  --no-start
#   RIVERRUN_DOMAIN  RIVERRUN_ADMIN_EMAIL  RIVERRUN_ADMIN_PASSWORD  OPENROUTER_API_KEY  SMTP_URL
set -Eeuo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
ENV_FILE=".env"

if [[ -t 1 ]]; then B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'; else B=''; G=''; Y=''; R=''; N=''; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s✕ %s%s\n' "$R" "$*" "$N" >&2; exit 1; }
trap 'die "Algo salió mal en la línea $LINENO. Revisa el mensaje anterior o corre ./riverrun status."' ERR

dc() { docker compose "$@"; }
need_docker() { command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; }
rand() { openssl rand -hex "${1:-24}"; }

env_get() { [[ -f "$ENV_FILE" ]] || return 0; sed -n "s/^$1=\\(.*\\)$/\\1/p" "$ENV_FILE" 2>/dev/null | tail -n 1; }
env_set() { # clave valor — reemplaza (o agrega) sin interpretar caracteres especiales
  local k="$1" v="$2" tmp; tmp="$(mktemp)"
  if grep -q "^$k=" "$ENV_FILE" 2>/dev/null; then
    K="$k" V="$v" awk 'BEGIN{FS=OFS="="} $1==ENVIRON["K"] {print ENVIRON["K"] "=" ENVIRON["V"]; next} {print}' "$ENV_FILE" > "$tmp"
  else
    { if [[ -f "$ENV_FILE" ]]; then cat "$ENV_FILE"; fi; echo "$k=$v"; } > "$tmp"
  fi
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"; chmod 600 "$ENV_FILE"
}
ask() { # prompt default → respuesta
  local prompt="$1" def="${2:-}" ans=""
  if [[ "${INTERACTIVE:-1}" == "1" ]]; then
    read -r -p "$prompt${def:+ [$def]}: " ans || true
  fi
  printf '%s' "${ans:-$def}"
}

app_url() {
  local d; d="$(env_get DOMAIN)"
  if [[ -n "$d" && "$(env_get COMPOSE_PROFILES)" == *https* ]]; then echo "https://$d"; else echo "http://127.0.0.1:3000"; fi
}

pg_image() { dc config --images 2>/dev/null | grep -iE 'postgres|pgvector' | head -n 1 || true; }

version() { git rev-parse --short HEAD 2>/dev/null || echo dev; }

wait_healthy() { # segundos (RIVERRUN_WAIT_SECONDS / RIVERRUN_POLL permiten acortarlo en pruebas)
  local limit="${RIVERRUN_WAIT_SECONDS:-${1:-150}}" poll="${RIVERRUN_POLL:-3}" i=0
  while (( i < limit )); do
    if dc exec -T backend wget -qO- http://127.0.0.1:3000/health >/dev/null 2>&1; then return 0; fi
    sleep "$poll"; i=$((i+poll))
  done
  return 1
}

# Salud completa del backend (JSON) con node y no wget: wget no imprime el cuerpo de un 503, justo cuando algo falla.
# Prefiere /health/functional (con HEALTH_TOKEN del propio contenedor). Un backend anterior, o uno sin token, no lo
# tiene y responde otra cosa: entonces se usa /health/ready, que es el formato que ya conocían las versiones viejas.
health_json() {
  local j
  j="$(dc exec -T backend node -e "const t=process.env.HEALTH_TOKEN||'';fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health/functional',{headers:t?{authorization:'Bearer '+t}:{}}).then(r=>r.text()).then(x=>process.stdout.write(x)).catch(()=>process.exit(1))" 2>/dev/null || true)"
  if [[ "$j" == *'"components"'* ]]; then printf '%s' "$j"; return 0; fi
  dc exec -T backend node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health/ready').then(r=>r.text()).then(t=>process.stdout.write(t)).catch(()=>process.exit(1))" 2>/dev/null || true
}
# Una línea "nombre ok|fail" por cada comprobación medida. Vacía si el backend no entrega un informe válido.
health_snapshot() {
  local j; j="$(health_json)"
  [[ "$j" == *'"components"'* || "$j" == *'"checks"'* ]] || return 0
  printf '%s' "$j" | grep -oE '"id":"[a-z_]*","state":"[a-z_]*"|"name":"[a-z_]*","status":"[a-z]*"' \
    | sed -E 's/"(id|name)":"([a-z_]*)","(state|status)":"([a-z_]*)"/\2 \4/' \
    | awk 'NF == 2 { print $1 ($2 == "no_disponible" || $2 == "fail" ? " fail" : " ok") }' || true
}
# Comprobaciones en falla ("ai whatsapp …"); "?" si el backend no responde.
health_failing() {
  local snap; snap="$(health_snapshot)"
  [[ -n "$snap" ]] || { echo "?"; return 0; }
  printf '%s\n' "$snap" | awk '$2 == "fail" { print $1 }' | tr '\n' ' '
}
# Después de actualizar: ninguna comprobación que se midió antes y estaba bien queda en falla. Lo que ya fallaba no
# bloquea, y una comprobación que no se midió antes no se puede atribuir a la actualización.
no_new_failures() {
  local snap now c new=""; snap="$(health_snapshot)"
  if [[ -z "$snap" ]]; then warn "El backend no responde a su comprobación de salud."; return 1; fi
  [[ "${HEALTH_BEFORE:-?}" == "?" ]] && return 0
  now="$(printf '%s\n' "$snap" | awk '$2 == "fail" { print $1 }')"
  for c in $now; do
    [[ " ${HEALTH_MEASURED:-} " == *" $c "* ]] || continue
    [[ " $HEALTH_BEFORE " == *" $c "* ]] || new="$new $c"
  done
  [[ -z "$new" ]] && return 0
  warn "Con la versión nueva falla (antes no):$new. Detalle: ./riverrun status o el panel (Sistema)."
  return 1
}
# Ventana de observación: la versión nueva debe seguir sana durante RIVERRUN_OBSERVE_SECONDS (120 por defecto; 0 la apaga)
# después de levantar. Un fallo que aparece minutos después (una conexión que se agota, un proveedor que cae) también
# revierte. Un fallo aislado no basta: hacen falta dos comprobaciones seguidas malas, como en las alertas.
observe_window() {
  local total="${RIVERRUN_OBSERVE_SECONDS:-120}" poll="${RIVERRUN_OBSERVE_POLL:-15}" elapsed=0 strikes=0
  [[ "$total" =~ ^[0-9]+$ && "$poll" =~ ^[1-9][0-9]*$ ]] || die "RIVERRUN_OBSERVE_SECONDS y RIVERRUN_OBSERVE_POLL deben ser números enteros (poll mayor que 0)."
  (( total > 0 )) || return 0
  say "Observando la versión nueva durante ${total} s (cada ${poll} s)…"
  while (( elapsed < total )); do
    sleep "$poll"
    elapsed=$((elapsed + poll))
    if no_new_failures; then
      strikes=0
      continue
    fi
    strikes=$((strikes + 1))
    if (( strikes >= 2 )); then
      warn "Falla sostenida durante la observación (a los ${elapsed} s): se vuelve a la versión anterior."
      return 1
    fi
    warn "Una comprobación falló a los ${elapsed} s; se vuelve a medir antes de decidir."
  done
  ok "La versión nueva se mantuvo sana durante ${total} s"
}

# Token de /health/functional y /metrics: se genera una vez y nunca se muestra.
ensure_health_token() {
  [[ -n "$(env_get HEALTH_TOKEN)" ]] && return 0
  env_set HEALTH_TOKEN "$(rand 32)"
  ok "Token de salud generado (HEALTH_TOKEN en .env; no se muestra)"
}

# Llave de los datos cifrados (INF-6), aparte de SESSION_SECRET. Generarla en una instalación con datos es seguro: lo
# cifrado antes sigue leyéndose con SESSION_SECRET y lo nuevo usa esta llave. Devuelve 0 si la acaba de generar.
ensure_data_key() {
  [[ -n "$(env_get DATA_KEY)" ]] && return 1
  env_set DATA_KEY "$(rand 32)"
  ok "Llave de datos generada (DATA_KEY en .env; no se muestra). Guárdala fuera del servidor junto con SESSION_SECRET."
  return 0
}

# INF-10: el puerto del panel publicado fuera de 127.0.0.1 lo abre Docker por su cuenta, por encima de ufw: el firewall
# del servidor no lo protege. Devuelve el texto del aviso (vacío si está bien).
panel_bind_warning() {
  local bind; bind="$(env_get PANEL_BIND)"
  case "${bind:-127.0.0.1}" in
    127.*|localhost|::1|"[::1]") return 0 ;;
  esac
  printf 'PANEL_BIND=%s publica el puerto 3000 del backend en %s: Docker lo abre por encima del firewall (ufw no lo bloquea). Usa Caddy (HTTPS) y deja PANEL_BIND=127.0.0.1, o limita el acceso en la cadena DOCKER-USER.' "$bind" "$bind"
}

# Redis con contraseña (INF-2): guarda las claves de las sesiones de WhatsApp. Se genera una vez.
ensure_redis_password() {
  [[ -n "$(env_get REDIS_PASSWORD)" ]] && return 0
  env_set REDIS_PASSWORD "$(rand 24)"
  ok "Contraseña de Redis generada (REDIS_PASSWORD en .env; no se muestra)"
}

wait_postgres() { # segundos
  local i
  # Por TCP: en el primer arranque, el servidor temporal que corre los scripts de inicio solo escucha en el socket.
  for (( i = 0; i < ${1:-60}; i++ )); do dc exec -T postgres pg_isready -h 127.0.0.1 -U chatbot >/dev/null 2>&1 && return 0; sleep 1; done
  return 1
}

# Un usuario de PostgreSQL por servicio (INF-2): el backend y Evolution dejan de usar el superusuario y cada uno solo
# entra a su base (docker/db-roles.sql). Se puede repetir: deja todo igual salvo los objetos nuevos o restaurados, que
# pasan a su dueño. Las contraseñas se generan una vez; el usuario se guarda en .env solo si todo salió bien (hasta
# entonces docker-compose.yml sigue usando el superusuario).
db_roles() {
  local app_pw evo_pw
  app_pw="$(env_get DB_APP_PASSWORD)"; [[ -n "$app_pw" ]] || app_pw="$(rand 24)"
  evo_pw="$(env_get DB_EVOLUTION_PASSWORD)"; [[ -n "$evo_pw" ]] || evo_pw="$(rand 24)"
  { printf '\\set app_pw %s\n\\set evo_pw %s\n' "'$app_pw'" "'$evo_pw'"; cat docker/db-roles.sql; } \
    | dc exec -T -e PGOPTIONS='-c client_min_messages=warning' postgres psql -X -q -U chatbot -d postgres >/dev/null || return 1
  env_set DB_APP_PASSWORD "$app_pw"; env_set DB_APP_USER riverrun_app
  env_set DB_EVOLUTION_PASSWORD "$evo_pw"; env_set DB_EVOLUTION_USER riverrun_evolution
}

# ./riverrun db-roles: lo mismo a mano (p. ej. tras restaurar con docker compose directamente) y reinicia.
cmd_db_roles() {
  need_docker || die "Docker no está disponible"
  dc up -d postgres >/dev/null
  wait_postgres 60 || die "PostgreSQL no respondió"
  db_roles || die "No se pudieron crear los usuarios de PostgreSQL (arriba el error). No se cambió la configuración."
  ok "Cada servicio con su usuario de PostgreSQL (DB_APP_USER y DB_EVOLUTION_USER en .env)"
  export APP_VERSION; APP_VERSION="$(version)"; dc up -d; wait_healthy 120 && ok "Funcionando" || die "No respondió: ./riverrun logs backend"
}

# ------------------------------------------------------------------ revisión previa y Evolution
# Revisa la configuración con la imagen del backend ya construida, sin arrancarla (nada se conecta).
# Devuelve 1 solo si hay problemas críticos; si la revisión no se puede correr (imagen anterior), no bloquea.
# Corre una herramienta del backend en un contenedor de un solo uso (sin dependencias). La salida de Docker
# ("Creating…") va a un archivo aparte: solo se muestra si la herramienta no pudo ni ejecutarse.
backend_tool() {
  local err rc=0; err="$(mktemp)"
  TOOL_OUT="$(dc run --rm --no-deps -T backend node "$@" 2>"$err")" || rc=$?
  if (( rc != 0 && rc != 2 && rc != 3 && rc != 4 )); then tail -n 5 "$err" >&2; fi
  rm -f "$err"; return "$rc"
}

# CFG_VERIFIED=1 solo si la revisión corrió de verdad. Si el backend no pudo ejecutarla, no bloquea (como antes),
# pero el preflight no debe decir "sin problemas críticos" sobre algo que no revisó.
CFG_VERIFIED=0
preflight_config() {
  local rc=0
  CFG_VERIFIED=0
  backend_tool dist/cli/config-check.js || rc=$?
  if (( rc == 2 )); then say "$TOOL_OUT"; return 1; fi
  if (( rc != 0 )); then warn "No se pudo revisar la configuración antes de aplicar (código $rc); el arranque la revisará."; return 0; fi
  CFG_VERIFIED=1
  say "$TOOL_OUT" | head -n 1 | sed 's/^/  /'
}

evo_target_image() { dc config evolution 2>/dev/null | awk '/^  evolution:$/{f=1;next} f&&/^  [^ ]/{f=0} f&&/^    image:/{print $2; exit}'; }
evo_container() { dc ps -q evolution 2>/dev/null | head -n 1; }
evo_running_ref() { local c; c="$(evo_container)"; [[ -z "$c" ]] || docker inspect --format '{{.Config.Image}}' "$c" 2>/dev/null || true; }
evo_running_id() { local c; c="$(evo_container)"; [[ -z "$c" ]] || docker inspect --format '{{.Image}}' "$c" 2>/dev/null || true; }
evo_image_id() { docker image inspect --format '{{.Id}}' "$1" 2>/dev/null || true; }
# La imagen que corre, por digest si se conoce: para volver a ella exactamente.
evo_running_pin() {
  local id d; id="$(evo_running_id)"; [[ -n "$id" ]] || return 0
  d="$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$id" 2>/dev/null | head -n 1)"
  if [[ -n "$d" ]]; then echo "$d"; else evo_running_ref; fi
}
# Última migración de la base de Evolution: "-" sin esquema todavía, "?" si no se pudo leer.
evo_db_migration() {
  local q="SELECT CASE WHEN to_regclass('public._prisma_migrations') IS NULL THEN '-' ELSE coalesce((SELECT max(migration_name) FROM _prisma_migrations WHERE finished_at IS NOT NULL AND rolled_back_at IS NULL), '-') END"
  local v; v="$(dc exec -T postgres psql -U chatbot -d evolution -Atc "$q" 2>/dev/null | tr -d '[:space:]')" || true
  echo "${v:-?}"
}
# Instancias del servidor de Evolution propio de la instalación con la sesión abierta (para comprobar que vuelven).
evo_open_instances() {
  dc exec -T postgres psql -U chatbot -d chatbot -Atc "SELECT coalesce(string_agg(config->>'instance', ','), '') FROM channels WHERE type = 'whatsapp' AND active AND connection_state = 'open' AND coalesce(config->>'url', '') = ''" 2>/dev/null | tr -d '[:space:]' || true
}
# ¿La imagen configurada es distinta de la que corre? (sin contenedor todavía no hay nada que proteger)
evo_change_pending() {
  local target running tid; target="$(evo_target_image)"; running="$(evo_running_ref)"
  [[ -n "$target" && -n "$running" && "$target" != "$running" ]] || return 1
  tid="$(evo_image_id "$target")"
  [[ -z "$tid" || "$tid" != "$(evo_running_id)" ]]
}
guard_evolution_change() {
  evo_change_pending || return 0
  die "La imagen de Evolution configurada ($(evo_target_image)) no es la que corre ($(evo_running_ref)). Cambiarla puede migrar su base de datos: aplícala con ./riverrun update (respaldo verificado, confirmación y verificación de sesiones)."
}

# Confirmación explícita para un cambio de Evolution con riesgo (migraciones o versión no verificada).
confirm_evolution() {
  if (( ACCEPT_EVO )); then warn "Cambio de Evolution aceptado con --accept-evolution-change."; return 0; fi
  if [[ -t 0 ]]; then
    local sure=""; read -r -p "Escribe ACTUALIZAR EVOLUTION para continuar (cualquier otra cosa cancela): " sure || true
    [[ "$sure" == "ACTUALIZAR EVOLUTION" ]] && return 0
    EVO_ABORT="Cancelado: no se aplicó nada."; return 1
  fi
  EVO_ABORT="Este cambio de Evolution requiere confirmación: léelo arriba y repite en una terminal interactiva o con --accept-evolution-change."
  return 1
}

# Compatibilidad, efecto sobre el esquema, confirmación y descarga. No toca lo que corre. Deja EVO_CHANGES.
evolution_preflight() {
  say; say "${B}Evolution API cambia de imagen${N}"
  say "  Ahora:   $EVO_BEFORE"; say "  Destino: $EVO_TARGET"; say "  Esquema actual de su base: $EVO_MIG_BEFORE"
  local rc=0
  backend_tool dist/cli/evolution-check.js plan --target "$EVO_TARGET" --db-migration "$EVO_MIG_BEFORE" || rc=$?
  say "$TOOL_OUT"
  case "$rc" in
    0) ;;
    3) confirm_evolution || return 1 ;;
    4) EVO_ABORT="La versión destino de Evolution no es segura para esta instalación (arriba). No se aplicó nada."; return 1 ;;
    *) EVO_ABORT="No se pudo evaluar la versión destino de Evolution (código $rc). No se aplicó nada."; return 1 ;;
  esac
  say "Descargando la imagen de Evolution…"
  dc pull evolution || { EVO_ABORT="No se pudo descargar la imagen de Evolution. No se aplicó nada."; return 1; }
  if [[ -n "$(evo_running_id)" && "$(evo_image_id "$EVO_TARGET")" == "$(evo_running_id)" ]]; then ok "Es la misma imagen que ya corre: Evolution no cambia."; return 0; fi
  EVO_CHANGES=1
}

# Después de aplicar: Evolution responde con la versión configurada y vuelven las sesiones que estaban abiertas.
evolution_verify() {
  (( EVO_CHANGES )) || return 0
  say "Verificando Evolution y las sesiones de WhatsApp (hasta ${RIVERRUN_EVO_WAIT:-120} s)…"
  local rc=0
  dc exec -T backend node dist/cli/evolution-check.js verify --previous-open "$EVO_OPEN" --wait "${RIVERRUN_EVO_WAIT:-120}" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) warn "Evolution funciona, con los avisos de arriba: revísalos en el panel (Sistema)."; return 0 ;;
    *) return 1 ;;
  esac
}

restore_backend_image() { # vuelve a etiquetar la imagen anterior del backend como la de compose
  [[ -n "${PREV_BACKEND:-}" ]] || return 0
  local img; img="$(dc config --images 2>/dev/null | grep -i backend | head -n 1)"
  [[ -n "$img" ]] && docker tag riverrun-backend:previous "$img"
  return 0
}

# Se detiene antes de aplicar nada: vuelve el código (y la imagen del backend ya construida) a como estaban.
abort_update() {
  git reset -q --hard "$OLD_HEAD"
  restore_backend_image
  die "$1"
}

# ------------------------------------------------------------------ install
# Llave con la que Docker firma sus paquetes (https://docs.docker.com/engine/install/ubuntu/): se revisa la huella
# antes de confiar en ella, en lugar de ejecutar un script bajado de internet (curl … | sh).
DOCKER_GPG_FPR="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"

# Instala Docker y su plugin compose desde el repositorio apt oficial (Debian, Ubuntu y sus derivados de Ubuntu).
# RIVERRUN_ETC (un /etc de mentira) solo se acepta con RIVERRUN_TEST=1, para las pruebas; en un servidor es /etc y hace
# falta ser root.
cmd_install_docker() {
  local etc=/etc
  if [[ "${RIVERRUN_TEST:-}" == "1" && -n "${RIVERRUN_ETC:-}" ]]; then etc="$RIVERRUN_ETC"
  else [[ "$(id -u)" == "0" ]] || die "Instalar Docker requiere root (sudo ./riverrun install-docker)"; fi
  local guide="instala Docker con la guía oficial (https://docs.docker.com/engine/install/)"
  [[ -r "$etc/os-release" ]] || die "No se reconoce el sistema: $guide"
  local id like codename ubuntu_codename
  osval() { sed -n "s/^$1=//p" "$etc/os-release" | tr -d '"' | head -n 1; }
  id="$(osval ID)"; like="$(osval ID_LIKE)"; codename="$(osval VERSION_CODENAME)"; ubuntu_codename="$(osval UBUNTU_CODENAME)"
  # Como en la guía de Docker: los derivados de Ubuntu (Mint, Pop!_OS…) usan el repositorio de Ubuntu con su UBUNTU_CODENAME.
  if [[ "$id" != ubuntu && "$id" != debian && " $like " == *" ubuntu "* && -n "$ubuntu_codename" ]]; then id=ubuntu; fi
  [[ "$id" == ubuntu && -n "$ubuntu_codename" ]] && codename="$ubuntu_codename"
  case "$id" in ubuntu|debian) ;; *) die "Este instalador solo conoce Debian y Ubuntu ($id): $guide" ;; esac
  [[ "$codename" =~ ^[a-z0-9]+$ ]] || die "No se reconoce la versión de $id (VERSION_CODENAME): $guide"

  say "Instalando Docker desde su repositorio oficial ($id $codename)…"
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl gnupg
  local tmp fpr
  tmp="$(mktemp)"
  curl -fsSL "https://download.docker.com/linux/$id/gpg" -o "$tmp" || { rm -f "$tmp"; die "No se pudo descargar la llave de Docker"; }
  # Una sola llave (un archivo con la de Docker y otra más pasaría si solo se viera la primera) y con la huella esperada.
  local keys pubs
  keys="$(gpg --show-keys --with-colons "$tmp" 2>/dev/null || true)"
  pubs="$(grep -c '^pub:' <<<"$keys" || true)"
  fpr="$(awk -F: '/^pub:/ { p = 1; next } p && /^fpr:/ { print $10; exit }' <<<"$keys")"
  if [[ "$pubs" != "1" || "$fpr" != "$DOCKER_GPG_FPR" ]]; then
    rm -f "$tmp"
    die "La llave descargada de Docker no es la esperada (huella $DOCKER_GPG_FPR; llegaron $pubs llave(s), la primera ${fpr:-sin huella}): no se instala nada"
  fi
  install -d -m 0755 "$etc/apt/keyrings" "$etc/apt/sources.list.d"
  install -m 0644 "$tmp" "$etc/apt/keyrings/docker.asc"
  rm -f "$tmp"
  printf 'deb [arch=%s signed-by=%s] https://download.docker.com/linux/%s %s stable\n' "$(dpkg --print-architecture)" "$etc/apt/keyrings/docker.asc" "$id" "$codename" > "$etc/apt/sources.list.d/docker.list"
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker instalado desde download.docker.com (llave verificada)"
}

# ------------------------------------------------------------------ servidor (etapa 9)
# Endurece el servidor (Debian, Ubuntu y la familia Red Hat; root): actualizaciones de seguridad automáticas, fail2ban para SSH, SSH solo con
# llave (si ya hay una llave autorizada: nunca deja a nadie fuera) y firewall que también frena lo que Docker publica
# (DOCKER-USER, que ufw no ve). Se puede repetir: reescribe sus propios archivos y nada más.
HARDEN_BEGIN="# BEGIN riverrun DOCKER-USER (./riverrun harden)"
HARDEN_END="# END riverrun DOCKER-USER"

# Bloque para after.rules / after6.rules: de afuera solo entra a los contenedores lo publicado a propósito (80/443 y
# HARDEN_ALLOW_PORTS); lo que sale de los contenedores y las respuestas siguen igual.
harden_docker_rules() { # $1 = 4|6, $2… = puertos tcp
  local p; shift
  printf '%s\n*filter\n:DOCKER-USER - [0:0]\n' "$HARDEN_BEGIN"
  printf '%s\n' "-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN"
  # Lo que sale de un contenedor (a internet o a otro contenedor) entra por su puente: sigue igual. Por interfaz y no
  # por rango de IP: otra máquina de la red privada del proveedor no pasa por aquí.
  printf '%s\n' "-A DOCKER-USER -i docker0 -j RETURN" "-A DOCKER-USER -i br-+ -j RETURN"
  for p in "$@"; do printf '%s\n' "-A DOCKER-USER -p tcp -m conntrack --ctorigdstport $p --ctdir ORIGINAL -j RETURN"; done
  [[ " $* " == *" 443 "* ]] && printf '%s\n' "-A DOCKER-USER -p udp -m conntrack --ctorigdstport 443 --ctdir ORIGINAL -j RETURN"
  printf '%s\n' "-A DOCKER-USER -m conntrack --ctstate NEW -j DROP" "-A DOCKER-USER -j RETURN" "COMMIT" "$HARDEN_END"
}

# Reemplaza (o agrega) el bloque de riverrun en un archivo de reglas de ufw, sin tocar lo demás.
harden_put_block() { # archivo contenido
  local f="$1" block="$2" tmp
  [[ -f "$f" ]] || return 0
  # Un bloque a medias (inicio sin fin) borraría el resto del archivo: mejor no tocarlo.
  [[ "$(grep -cxF "$HARDEN_BEGIN" "$f" || true)" == "$(grep -cxF "$HARDEN_END" "$f" || true)" ]] \
    || die "$f tiene un bloque de riverrun incompleto (inicio sin fin): corrígelo a mano y vuelve a correr harden."
  cp -p "$f" "$f.riverrun-bak"
  tmp="$(mktemp)"
  B1="$HARDEN_BEGIN" B2="$HARDEN_END" awk '$0 == ENVIRON["B1"] { skip = 1 } !skip { print } $0 == ENVIRON["B2"] { skip = 0 }' "$f" > "$tmp"
  printf '%s\n' "$block" >> "$tmp"
  cat "$tmp" > "$f"; rm -f "$tmp"
}

# ¿Alguien puede entrar por SSH con llave? Sin eso, apagar las contraseñas dejaría el servidor sin acceso.
# Se revisa la cuenta de quien corre harden (SUDO_USER, o root), no cualquiera: si tú entras con contraseña y la llave es
# de otra persona, apagar las contraseñas te dejaría fuera a ti.
harden_has_ssh_key() { # raíz del sistema, usuario
  local root="$1" user="$2" home f
  if [[ "$user" == root ]]; then home=/root
  elif [[ -n "$root" ]]; then home="/home/$user"
  else home="$(getent passwd "$user" | cut -d: -f6)"; fi
  [[ -n "$home" ]] || return 1
  f="$root$home/.ssh/authorized_keys"
  [[ -f "$f" ]] || return 1
  if command -v ssh-keygen >/dev/null 2>&1; then ssh-keygen -l -f "$f" >/dev/null 2>&1; return; fi
  grep -Eq '(^|[[:space:],])(ssh-(ed25519|rsa|dss)|ecdsa-sha2-[a-z0-9]+|sk-[a-z0-9@.-]+)[[:space:]]+AAAA[A-Za-z0-9+/=]+' "$f"
}

# Todos los puertos en los que SSH escucha de verdad: lo que dice sshd, lo que está abierto (con ssh.socket, Ubuntu 24.04
# ignora el Port de sshd_config) y el de esta misma sesión. Sin ninguno, no se adivina.
harden_ssh_ports() {
  {
    sshd -T 2>/dev/null | awk '$1 == "port" { print $2 }' || true
    if command -v ss >/dev/null 2>&1; then ss -Hltnp 2>/dev/null | awk '/"sshd"/ { n = split($4, a, ":"); print a[n] }' || true; fi
    if systemctl is-active --quiet ssh.socket 2>/dev/null; then
      systemctl show -p Listen --value ssh.socket 2>/dev/null | tr ' ' '\n' | sed -n 's/.*:\([0-9]\{1,5\}\)$/\1/p' || true
    fi
    if [[ -n "${SSH_CONNECTION:-}" ]]; then printf '%s\n' "${SSH_CONNECTION##* }"; fi
  } | { grep -E '^[0-9]{1,5}$' || true; } | sort -un | tr '\n' ' ' | sed 's/ $//'
}

# dnf-automatic: solo actualizaciones de seguridad, y que se apliquen (no solo se descarguen). Cambia esas dos líneas
# del archivo si ya existe; si no, lo escribe.
harden_dnf_automatic() { # archivo
  local f="$1"
  install -d -m 0755 "$(dirname "$f")"
  if [[ -f "$f" ]]; then
    cp -p "$f" "$f.riverrun-bak"
    sed -i -E 's/^[#[:space:]]*upgrade_type[[:space:]]*=.*/upgrade_type = security/; s/^[#[:space:]]*apply_updates[[:space:]]*=.*/apply_updates = yes/' "$f"
    grep -q '^upgrade_type = security' "$f" || printf '[commands]\nupgrade_type = security\napply_updates = yes\n' >> "$f"
  else
    printf '[commands]\nupgrade_type = security\napply_updates = yes\n' > "$f"
  fi
}

# firewalld: SSH y los puertos públicos en la zona por omisión, y las mismas reglas de DOCKER-USER como reglas directas
# (firewalld tampoco ve lo que Docker publica). Se quitan las de antes y se ponen otra vez: se puede repetir.
harden_firewalld() { # puertos-ssh puertos…
  local sshp="$1" p v rule i; shift
  systemctl enable --now firewalld >/dev/null 2>&1 || die "No se pudo encender firewalld: revisa con systemctl status firewalld"
  for p in $sshp; do firewall-cmd --permanent --add-port="$p/tcp" >/dev/null; done
  for p in "$@"; do firewall-cmd --permanent --add-port="$p/tcp" >/dev/null; done
  [[ " $* " == *" 443 "* ]] && firewall-cmd --permanent --add-port=443/udp >/dev/null
  for v in 4 6; do
    firewall-cmd --permanent --direct --remove-rules "ipv$v" filter DOCKER-USER >/dev/null 2>&1 || true
    firewall-cmd --permanent --direct --add-chain "ipv$v" filter DOCKER-USER >/dev/null 2>&1 || true
    i=0
    while IFS= read -r rule; do
      [[ "$rule" == "-A DOCKER-USER "* ]] || continue
      # shellcheck disable=SC2086 # la regla son varias palabras a propósito
      firewall-cmd --permanent --direct --add-rule "ipv$v" filter DOCKER-USER "$i" ${rule#-A DOCKER-USER } >/dev/null
      i=$((i + 1))
    done < <(harden_docker_rules "$v" "$@")
  done
  firewall-cmd --reload >/dev/null
}

cmd_harden() {
  local yes=0 fw=1 ssh=1 a
  for a in "$@"; do
    case "$a" in
      --yes) yes=1 ;;
      --skip-firewall) fw=0 ;;
      --skip-ssh) ssh=0 ;;
      *) die "Opción desconocida: $a (uso: sudo ./riverrun harden [--yes] [--skip-firewall] [--skip-ssh])" ;;
    esac
  done
  local root=""
  if [[ "${RIVERRUN_TEST:-}" == "1" && -n "${RIVERRUN_ROOT:-}" ]]; then root="$RIVERRUN_ROOT"
  else [[ "$(id -u)" == "0" ]] || die "Endurecer el servidor requiere root (sudo ./riverrun harden)"; fi
  local etc="$root/etc"
  [[ -r "$etc/os-release" ]] || die "No se reconoce el sistema: harden conoce Debian, Ubuntu, Fedora, AlmaLinux, Rocky y RHEL."
  local id like
  id="$(sed -n 's/^ID=//p' "$etc/os-release" | tr -d '"' | head -n 1)"; like="$(sed -n 's/^ID_LIKE=//p' "$etc/os-release" | tr -d '"' | head -n 1)"
  # Dos familias: Debian/Ubuntu (apt, unattended-upgrades, ufw) y Red Hat (dnf, dnf-automatic, firewalld).
  local fam=""
  if [[ "$id" == debian || "$id" == ubuntu || " $like " == *" debian "* || " $like " == *" ubuntu "* ]]; then fam=deb
  elif [[ "$id" =~ ^(fedora|rhel|centos|almalinux|rocky)$ || " $like " == *" rhel "* || " $like " == *" fedora "* ]]; then fam=rhel
  else die "harden conoce Debian, Ubuntu, Fedora, AlmaLinux, Rocky y RHEL ($id): endurece este servidor a mano (docs/produccion.md)."; fi

  # Puerto de SSH real (puede no ser el 22) y lo que se publica: 80/443 con dominio, más HARDEN_ALLOW_PORTS.
  local sshp; sshp="$(harden_ssh_ports)"
  [[ -n "$sshp" ]] || die "No se pudo saber en qué puerto escucha SSH (sshd -T, ss): no se toca nada para no dejarte fuera."
  local me="${SUDO_USER:-root}" client="${SSH_CONNECTION:-}"; client="${client%% *}"
  local ports=() p extra
  [[ "$(env_get COMPOSE_PROFILES)" == *https* ]] && ports+=(80 443)
  extra="${HARDEN_ALLOW_PORTS:-$(env_get HARDEN_ALLOW_PORTS)}"
  for p in ${extra//,/ }; do
    [[ "$p" =~ ^[0-9]{1,5}$ ]] && (( p > 0 && p < 65536 )) || die "HARDEN_ALLOW_PORTS: «$p» no es un puerto."
    ports+=("$p")
  done
  local keyok=0; harden_has_ssh_key "$root" "$me" && keyok=1

  say "${B}Endurecer el servidor${N}"
  if [[ "$fam" == deb ]]; then say "  · Actualizaciones de seguridad automáticas (unattended-upgrades)."
  else say "  · Actualizaciones de seguridad automáticas (dnf-automatic, solo las de seguridad)."; fi
  say "  · fail2ban: bloquea una hora las IP que fallan 5 veces al entrar por SSH (puerto $sshp)."
  if (( ssh && keyok )); then say "  · SSH solo con llave: sin contraseñas, root solo con llave, 3 intentos por conexión."
  elif (( ssh )); then warn "  · SSH: se deja como está. La cuenta $me no tiene una llave válida en authorized_keys: apagar las contraseñas te dejaría fuera."
  fi
  local pbind; pbind="$(env_get PANEL_BIND)"
  if (( fw )) && [[ -n "$pbind" && "$pbind" != 127.0.0.1* && "$pbind" != localhost* && " ${ports[*]} " != *" 3000 "* ]]; then
    warn "  · PANEL_BIND=$pbind: con el firewall, el panel deja de verse desde afuera (lo correcto). Si lo necesitas, HARDEN_ALLOW_PORTS=3000."
  fi
  if (( fw )); then
    say "  · Firewall ($([[ "$fam" == deb ]] && echo ufw || echo firewalld)): entra solo SSH ($sshp)${ports[*]:+ y ${ports[*]}}; también para lo que Docker publica."
  fi
  if (( ! yes )); then
    [[ -t 0 ]] || die "Sin terminal: confirma con --yes."
    local sure=""; read -r -p "¿Aplicar? Mantén abierta esta sesión de SSH y prueba entrar desde otra antes de cerrarla (s/n): " sure || true
    [[ "$sure" =~ ^[sSyY] ]] || die "Cancelado: no se cambió nada."
  fi

  if [[ "$fam" == deb ]]; then
    apt-get update -qq || warn "apt-get update tuvo errores (¿un repositorio roto?): se instala con lo que haya."
    local pkgs=(unattended-upgrades fail2ban python3-systemd)
    (( fw )) && pkgs+=(ufw)
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}"
    install -d -m 0755 "$etc/apt/apt.conf.d"
    printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' > "$etc/apt/apt.conf.d/20auto-upgrades"
  else
    # fail2ban viene de EPEL fuera de Fedora.
    [[ "$id" == fedora ]] || dnf install -y -q epel-release || warn "No se pudo agregar EPEL: fail2ban puede no instalarse."
    local pkgs=(dnf-automatic fail2ban python3-systemd)
    (( fw )) && pkgs+=(firewalld)
    dnf install -y -q "${pkgs[@]}"
    harden_dnf_automatic "$etc/dnf/automatic.conf"
    systemctl enable --now dnf-automatic.timer >/dev/null 2>&1 || warn "No se pudo encender dnf-automatic.timer: revisa con systemctl status dnf-automatic.timer"
  fi
  install -d -m 0755 "$etc/fail2ban/jail.d"
  ok "Actualizaciones de seguridad automáticas"

  # Tu propia IP (la de esta sesión) nunca se bloquea: un agente con varias llaves falla varias veces antes de acertar.
  printf '[sshd]\nenabled = true\nport = %s\nbackend = systemd\nmaxretry = 5\nfindtime = 10m\nbantime = 1h\nignoreip = 127.0.0.1/8 ::1%s\n' \
    "${sshp// /,}" "${client:+ $client}" > "$etc/fail2ban/jail.d/riverrun.local"
  systemctl enable --now fail2ban >/dev/null 2>&1 || true
  systemctl restart fail2ban || warn "fail2ban no arrancó: revisa con systemctl status fail2ban"
  ok "fail2ban vigila SSH"

  if (( ssh && keyok )); then
    local conf="$etc/ssh/sshd_config.d/01-riverrun.conf"
    # Va primero (01-…): en sshd gana el primer valor, y un 50-cloud-init.conf suele volver a encender las contraseñas.
    grep -Eqi '^[[:space:]]*Include[[:space:]].*sshd_config\.d' "$etc/ssh/sshd_config" 2>/dev/null \
      || warn "sshd_config no incluye sshd_config.d: agrega «Include /etc/ssh/sshd_config.d/*.conf» al principio para que esto aplique."
    install -d -m 0755 "$etc/ssh/sshd_config.d"
    # OpenSSH anterior a 8.7 (Ubuntu 20.04) no conoce KbdInteractiveAuthentication: ahí es ChallengeResponseAuthentication.
    local kbd=KbdInteractiveAuthentication
    sshd -T 2>/dev/null | grep -qi '^kbdinteractiveauthentication' || kbd=ChallengeResponseAuthentication
    printf '# ./riverrun harden: SSH solo con llave.\nPasswordAuthentication no\n%s no\nPermitRootLogin prohibit-password\n' "$kbd" > "$conf"
    if ! sshd -t; then rm -f "$conf"; die "La configuración de SSH no es válida: no se aplicó (SSH sigue como estaba)."; fi
    systemctl reload ssh 2>/dev/null || systemctl reload sshd || warn "No se pudo recargar SSH: aplica al reiniciar el servicio."
    # Con -C se evalúan también los bloques Match (uno puede volver a encender las contraseñas para algunos).
    if sshd -T -C "user=$me,host=riverrun,addr=${client:-203.0.113.1}" 2>/dev/null | grep -qi '^passwordauthentication yes' \
       || { grep -Eqi '^[[:space:]]*Match[[:space:]]' "$etc/ssh/sshd_config" "$etc"/ssh/sshd_config.d/*.conf 2>/dev/null \
            && grep -Eqi '^[[:space:]]*PasswordAuthentication[[:space:]]+yes' "$etc/ssh/sshd_config" "$etc"/ssh/sshd_config.d/*.conf 2>/dev/null; }; then
      warn "SSH sigue aceptando contraseñas: otro archivo lo define antes. Revisa /etc/ssh/sshd_config y sshd_config.d."
    else ok "SSH solo con llave"; fi
  fi

  if (( fw )) && [[ "$fam" == rhel ]]; then
    harden_firewalld "$sshp" "${ports[@]}"
    ok "Firewall activo (firewalld): entra SSH ($sshp)${ports[*]:+ y ${ports[*]}}; lo demás que Docker publique queda cerrado hacia afuera"
  elif (( fw )); then
    # ufw no ve lo que Docker publica (sus reglas van antes): las de DOCKER-USER sí.
    harden_put_block "$etc/ufw/after.rules" "$(harden_docker_rules 4 "${ports[@]}")"
    harden_put_block "$etc/ufw/after6.rules" "$(harden_docker_rules 6 "${ports[@]}")"
    # Antes de encender: que iptables acepte los archivos (si no, se dejan como estaban).
    if [[ "${RIVERRUN_TEST:-}" != "1" ]] && command -v iptables-restore >/dev/null 2>&1; then
      if ! iptables-restore --test -n < "$etc/ufw/after.rules" || { command -v ip6tables-restore >/dev/null 2>&1 && ! ip6tables-restore --test -n < "$etc/ufw/after6.rules"; }; then
        cp -p "$etc/ufw/after.rules.riverrun-bak" "$etc/ufw/after.rules" 2>/dev/null || true
        cp -p "$etc/ufw/after6.rules.riverrun-bak" "$etc/ufw/after6.rules" 2>/dev/null || true
        die "Las reglas del firewall no son válidas: se dejaron como estaban y el firewall no se encendió."
      fi
    fi
    ufw default deny incoming >/dev/null
    ufw default allow outgoing >/dev/null
    for p in $sshp; do ufw limit "$p/tcp" >/dev/null; done
    for p in "${ports[@]}"; do ufw allow "$p/tcp" >/dev/null; done
    [[ " ${ports[*]} " == *" 443 "* ]] && ufw allow 443/udp >/dev/null
    ufw --force enable >/dev/null
    ufw reload >/dev/null
    ok "Firewall activo: entra SSH ($sshp)${ports[*]:+ y ${ports[*]}}; lo demás que Docker publique queda cerrado hacia afuera"
  fi
  printf 'harden %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$etc/riverrun-harden"
  say; ok "Servidor endurecido. Antes de cerrar esta sesión, prueba entrar por SSH desde otra terminal."
}

# ------------------------------------------------------------------ llaves (INF-12)
# Las llaves que hay que guardar fuera del servidor. No se imprimen en la instalación (quedarían en el historial de la
# terminal o en los registros de quien la automatice): se piden aquí, a propósito.
cmd_keys() {
  local out=0 a
  for a in "$@"; do case "$a" in --stdout) out=1 ;; *) die "Opción desconocida: $a (uso: ./riverrun keys [--stdout])" ;; esac; done
  [[ -f "$ENV_FILE" ]] || die "No hay .env: primero ./riverrun install"
  [[ -t 1 || "$out" == 1 ]] || die "La salida no es una terminal: las llaves no se escriben en archivos ni registros. Si de verdad quieres eso, usa --stdout."
  say "${B}Guarda esto fuera del servidor (gestor de contraseñas) y limpia la pantalla después (clear):${N}"
  local k v
  for k in BACKUP_PASSPHRASE SESSION_SECRET DATA_KEY DATA_KEYS_OLD; do
    v="$(env_get "$k")"; [[ -n "$v" ]] && say "  $k=$v"
  done
  say "Sin BACKUP_PASSPHRASE no se pueden restaurar los respaldos; sin DATA_KEY (y DATA_KEYS_OLD), lo cifrado en la base"
  say "(2FA, calendarios, credenciales de canales) no se puede leer al restaurar en otro servidor."
  return 0
}

cmd_install() {
  INTERACTIVE=1; START=1
  for a in "$@"; do case "$a" in --non-interactive) INTERACTIVE=0 ;; --no-start) START=0 ;; *) die "Opción desconocida: $a" ;; esac; done
  [[ -t 0 ]] || INTERACTIVE=0
  say "${B}Instalación de Riverrun${N}"; say

  if (( START )) && ! need_docker; then
    warn "Docker (con el plugin compose) no está instalado."
    if [[ "$INTERACTIVE" == "1" && "$(id -u)" == "0" ]]; then
      if [[ "$(ask '¿Instalarlo ahora desde el repositorio oficial de Docker? (s/n)' s)" =~ ^[sSyY] ]]; then
        cmd_install_docker
      fi
    fi
    need_docker || die "Instala Docker (https://docs.docker.com/engine/install/) y vuelve a correr ./riverrun install"
  fi
  command -v openssl >/dev/null 2>&1 || die "Falta openssl (apt install openssl)"

  [[ -f "$ENV_FILE" ]] || { cp .env.example "$ENV_FILE"; chmod 600 "$ENV_FILE"; NEW=1; }
  : "${NEW:=0}"
  [[ "$NEW" == "1" ]] && ok "Archivo .env creado" || warn "Ya existe .env: se conserva y solo se completa lo que falte"
  local pbi; pbi="$(panel_bind_warning)"; [[ -z "$pbi" ]] || warn "$pbi"

  # Claves internas: se generan una sola vez y nunca se pisan.
  local gen=0 k
  for k in POSTGRES_PASSWORD EVOLUTION_API_KEY SESSION_SECRET DATA_KEY BACKUP_PASSPHRASE HEALTH_TOKEN REDIS_PASSWORD; do
    local cur; cur="$(env_get "$k")"
    if [[ -z "$cur" || "$cur" == cambia-esta-clave* ]]; then
      case "$k" in POSTGRES_PASSWORD) env_set "$k" "$(rand 16)" ;; *) env_set "$k" "$(rand 32)" ;; esac
      gen=1
      # Una base que ya existía guarda la contraseña anterior en su volumen: hay que cambiarla también adentro.
      if [[ "$k" == POSTGRES_PASSWORD && "$NEW" != "1" && -n "$cur" ]]; then
        warn "Se generó una contraseña nueva para la base (la de ejemplo es pública). Si la base ya existía, cámbiala también en PostgreSQL:"
        warn "  docker compose exec postgres psql -U chatbot -c \"ALTER USER chatbot PASSWORD '\$(grep '^POSTGRES_PASSWORD=' .env | cut -d= -f2-)'\""
      fi
    fi
  done
  (( gen )) && ok "Claves internas generadas"

  # Datos del negocio
  local domain email pass
  domain="${RIVERRUN_DOMAIN:-$(env_get DOMAIN)}"; [[ "$domain" == "chatbot.tudominio.com" ]] && domain=""
  if [[ -z "${RIVERRUN_DOMAIN:-}" && "$NEW" == "1" && "$INTERACTIVE" == "1" ]]; then
    say; say "Dominio (ej. bot.minegocio.com): necesario para HTTPS, Telegram, Instagram, Messenger y el chat web."
    say "Apúntalo antes (registro DNS tipo A) a la IP de este servidor. Déjalo vacío para probar solo en este servidor."
    domain="$(ask 'Dominio' "$domain")"
  fi
  email="${RIVERRUN_ADMIN_EMAIL:-$(env_get ADMIN_USER)}"; [[ "$email" == "tu@correo.com" ]] && email=""
  if [[ -z "${RIVERRUN_ADMIN_EMAIL:-}" && ( "$NEW" == "1" || -z "$email" ) ]]; then email="$(ask 'Tu correo (será el usuario administrador)' "$email")"; fi
  [[ -n "$email" ]] || die "Falta el correo del administrador (RIVERRUN_ADMIN_EMAIL)"
  env_set ADMIN_USER "$email"; env_set SUPERADMIN_EMAIL "$email"

  pass="${RIVERRUN_ADMIN_PASSWORD:-}"
  local shown=""
  # ADMIN_PASSWORD solo crea al superadministrador la primera vez (después no cambia nada: ./riverrun admin-password).
  local current; current="$(env_get ADMIN_PASSWORD)"
  if [[ "$NEW" == "1" || "$current" == cambia-esta-clave* ]]; then
    [[ -n "$pass" ]] || { pass="$(rand 9)"; shown="$pass"; }
    env_set ADMIN_PASSWORD "$pass"
  else
    if [[ -n "$pass" ]]; then warn "RIVERRUN_ADMIN_PASSWORD solo se usa al instalar por primera vez; para cambiar la contraseña: ./riverrun admin-password"; fi
    # Sigue en .env: la instalación anterior no terminó (al terminar se vacía). Se vuelve a mostrar al final.
    if [[ -n "$current" && -z "$pass" ]]; then shown="$current"; fi
  fi

  if [[ -n "$domain" ]]; then
    env_set DOMAIN "$domain"; env_set SECURE_COOKIES true; env_set COMPOSE_PROFILES https
    env_set PUBLIC_BASE_URL "https://$domain"; env_set MAIL_FROM "Riverrun <no-responder@$domain>"
  else
    env_set SECURE_COOKIES false; env_set COMPOSE_PROFILES ""; env_set DOMAIN "localhost"; env_set PUBLIC_BASE_URL "http://127.0.0.1:3000"
  fi

  local key="${OPENROUTER_API_KEY:-$(env_get OPENROUTER_API_KEY)}"
  if [[ -z "$key" && "$NEW" == "1" && "$INTERACTIVE" == "1" ]]; then
    say; say "Clave de OpenRouter (https://openrouter.ai/keys): es lo que hace responder al asistente."
    key="$(ask 'OPENROUTER_API_KEY (Enter para ponerla después)' '')"
  fi
  [[ -n "$key" ]] && env_set OPENROUTER_API_KEY "$key"
  # Alertas: sin ellas nadie se entera de noche si algo falla (servidor caído, WhatsApp desconectado, clientes sin respuesta).
  local smtp="${SMTP_URL:-$(env_get SMTP_URL)}" hb="${HEARTBEAT_URL:-$(env_get HEARTBEAT_URL)}" hook="${ALERT_WEBHOOK_URL:-$(env_get ALERT_WEBHOOK_URL)}"
  if [[ "$NEW" == "1" && "$INTERACTIVE" == "1" ]]; then
    say; say "Alertas (recomendado): así te enteras aunque no tengas el panel abierto."
    [[ -n "$smtp" ]] || { say "Correo para enviar avisos, formato smtps://usuario:clave@servidor:465 (Gmail: usa una contraseña de aplicación)."; smtp="$(ask 'SMTP_URL (Enter para omitir)' '')"; }
    [[ -n "$hb" ]] || { say "Latido externo: crea un chequeo gratis en https://healthchecks.io y pega su URL; si el servidor se cae, te avisan."; hb="$(ask 'HEARTBEAT_URL (Enter para omitir)' '')"; }
    [[ -n "$hook" ]] || hook="$(ask 'ALERT_WEBHOOK_URL de Slack, Discord o ntfy (Enter para omitir)' '')"
  fi
  [[ -n "$smtp" ]] && env_set SMTP_URL "$smtp"
  [[ -n "$hb" ]] && env_set HEARTBEAT_URL "$hb"
  [[ -n "$hook" ]] && env_set ALERT_WEBHOOK_URL "$hook"
  if [[ -z "$(env_get HEARTBEAT_URL)" ]]; then warn "Sin HEARTBEAT_URL nadie te avisa si el servidor completo se cae (configúralo después en .env)."; fi
  if [[ -z "$(env_get SMTP_URL)" ]]; then
    env_set SIGNUP_REQUIRE_EMAIL false
    warn "Sin SMTP_URL no se envían correos: la confirmación de correo queda desactivada (puedes activarla después)."
  fi
  ok "Configuración guardada en .env"

  if (( ! START )); then
    say; ok "Listo (sin iniciar: usaste --no-start). Para arrancar: ./riverrun restart"
    if [[ -n "$shown" && -t 1 ]]; then say "  Contraseña generada del administrador: ${B}$shown${N}"
    elif [[ -n "$shown" ]]; then say "  Contraseña generada del administrador: en .env (ADMIN_PASSWORD); no se muestra porque la salida no es una terminal."; fi
    return 0
  fi

  say; say "${B}Construyendo y arrancando (la primera vez tarda unos minutos)…${N}"
  export APP_VERSION; APP_VERSION="$(version)"
  # Primero la base, para darle a cada servicio su usuario antes de que arranquen.
  dc up -d postgres
  wait_postgres 120 || die "PostgreSQL no respondió: ./riverrun logs postgres"
  db_roles || die "No se pudieron crear los usuarios de PostgreSQL (arriba el error)."
  ok "Usuarios de PostgreSQL por servicio creados"
  dc up -d --build
  say "Esperando a que el sistema responda…"
  wait_healthy 180 || { dc logs --tail 40 backend || true; die "El sistema no respondió a tiempo. Revisa los registros de arriba o corre ./riverrun logs backend"; }
  ok "El sistema está funcionando"
  # Ya creó al superadministrador: la contraseña inicial no se queda en .env (se cambia en el panel o con admin-password).
  if [[ -n "$(env_get ADMIN_PASSWORD)" ]]; then env_set ADMIN_PASSWORD ""; fi

  # Búsqueda semántica (pgvector): útil con catálogos grandes. Opcional; si falla, el asistente sigue con palabras clave.
  if [[ -n "$(env_get OPENROUTER_API_KEY)" ]]; then
    local sem="${RIVERRUN_SEMANTIC:-}"
    if [[ -z "$sem" && "$INTERACTIVE" == "1" ]]; then sem="$(ask '¿Activar la búsqueda semántica? Mejora las respuestas con catálogos grandes (s/n)' s)"; fi
    [[ "$sem" =~ ^([sSyY]|1|true)$ ]] && { cmd_semantic --no-backup || warn "No se activó la búsqueda semántica; puedes intentarlo después con ./riverrun semantic"; }
  fi

  say; say "${B}Todo listo.${N}"
  say "  Panel:      $(app_url)"
  say "  Usuario:    $email"
  if [[ -n "$shown" && -t 1 ]]; then say "  Contraseña: ${B}$shown${N}  (cámbiala en el panel → Mi perfil)"
  elif [[ -n "$shown" ]]; then say "  Contraseña: no se muestra (la salida no es una terminal). Crea una con ./riverrun admin-password"
  else say "  Contraseña: la que ya tenías (¿sin acceso? ./riverrun admin-password crea una nueva)"; fi
  say
  say "${B}Guarda las llaves fuera del servidor${N} (gestor de contraseñas): ./riverrun keys las muestra."
  say "  Sin ellas no se pueden restaurar los respaldos ni leer lo cifrado en otro servidor."
  say "${B}Endurece el servidor${N} (firewall, SSH solo con llave, fail2ban, actualizaciones): sudo ./riverrun harden"
  say
  [[ "$(app_url)" == http://127.0.0.1* ]] && say "Para abrir el panel desde tu computadora: ssh -L 3000:127.0.0.1:3000 usuario@este-servidor  →  http://localhost:3000"
  [[ -n "$domain" ]] && say "Recuerda abrir los puertos 80 y 443 del servidor y apuntar $domain a esta IP."
  [[ -z "$(env_get OPENROUTER_API_KEY)" ]] && warn "Falta OPENROUTER_API_KEY en .env: sin ella el asistente no responde. Después: ./riverrun restart"
  say "Otros comandos: ./riverrun status · update · backup · restore · logs"
}

# ------------------------------------------------------------------ status
cmd_status() {
  need_docker || die "Docker no está disponible"
  say "${B}Servicios${N}"; dc ps --format 'table {{.Service}}\t{{.Status}}' 2>/dev/null || dc ps
  say; say "${B}Salud${N}"
  local j; j="$(health_json)"
  if [[ -z "$j" ]]; then warn "El backend no responde"; else
    say "$j" | sed 's/},{/}\n{/g; s/[][{}"]//g; s/checks://' | sed 's/^/  /'
  fi
  say; say "${B}Respaldos${N}"
  dc exec -T backup /usr/local/bin/backup.sh list 2>/dev/null | tail -n 4 | sed 's/^/  /' || warn "El contenedor de respaldos no está activo"
  say; say "${B}Evolution API${N}"
  say "  Imagen en uso:      $(evo_running_ref)"
  say "  Imagen configurada: $(evo_target_image)"
  if evo_change_pending; then warn "La imagen configurada no es la que corre: aplícala con ./riverrun update"; fi
  dc exec -T backend node dist/cli/evolution-check.js status 2>/dev/null || warn "No se pudo consultar Evolution desde el backend (revisa el panel → Sistema)"
  say; say "${B}Versión${N}  $(version)"
  if git rev-parse --git-dir >/dev/null 2>&1 && git fetch -q origin 2>/dev/null; then
    local behind; behind="$(git rev-list --count HEAD..'@{u}' 2>/dev/null || echo 0)"
    (( behind > 0 )) && warn "Hay $behind cambios nuevos disponibles: ./riverrun update" || ok "Estás en la última versión"
  fi
  df -h . | awk 'NR==2 {print "\nDisco: " $4 " libres (" $5 " usado)"}'
}

# ------------------------------------------------------------------ backup / restore
cmd_backup() {
  need_docker || die "Docker no está disponible"
  dc exec -T backup /usr/local/bin/backup.sh now
}

cmd_restore() {
  need_docker || die "Docker no está disponible"
  local target="${1:-latest}" extra=()
  say "${R}${B}Restaurar reemplaza TODOS los datos actuales (conversaciones, cuentas, fotos, sesiones de WhatsApp).${N}"
  if [[ -f "$target" ]]; then
    # Archivo traído de fuera (p. ej. bajado de la nube a un servidor nuevo).
    local host; host="$(readlink -f "$target")"
    # La terminación dice el formato: .gpg.tar (partes cifradas con gpg), .tar.enc (de antes) o .tar.
    case "$host" in *.tar.enc) target="/tmp/restore-input.tar.enc" ;; *.gpg.tar) target="/tmp/restore-input.gpg.tar" ;; *) target="/tmp/restore-input.tar" ;; esac
    extra=(-v "$host:$target:ro")
  else
    say "Respaldos disponibles:"; dc run --rm --no-deps -T restore list 2>/dev/null </dev/null | sed 's/^/  /' || true
  fi
  local sure=""; read -r -p "Escribe RESTAURAR para continuar: " sure || true
  [[ "$sure" == "RESTAURAR" ]] || die "Cancelado."
  say "Haciendo un respaldo de seguridad de lo que hay ahora…"
  dc exec -T -e BACKUP_PREFIX=prerestore backup /usr/local/bin/backup.sh now >/dev/null 2>&1 && ok "Respaldo de seguridad hecho" || warn "No se pudo (¿instalación nueva?). Continúo."
  dc stop backend evolution redis >/dev/null 2>&1 || true
  dc up -d postgres >/dev/null
  dc run --rm "${extra[@]}" restore restore "$target"
  # Las claves de las sesiones de WhatsApp (Redis): se cargan con el propio Redis antes de arrancar Evolution.
  # (Sin copia de Redis en el respaldo, el script lo dice y no toca nada.)
  dc run --rm --no-deps -T --entrypoint sh redis -s < docker/backup/redis-load.sh \
    || warn "No se pudieron cargar las claves de las sesiones de WhatsApp (Redis): si algún WhatsApp no recibe mensajes, vincúlalo de nuevo."
  # Lo restaurado queda del superusuario: se devuelve a cada servicio (y se crean sus usuarios si el servidor es nuevo).
  db_roles || die "Se restauró, pero no se pudieron dar los permisos a cada servicio: corre ./riverrun db-roles"
  export APP_VERSION; APP_VERSION="$(version)"
  dc up -d
  wait_healthy 180 && ok "Restauración completa y sistema funcionando" || die "Se restauró pero el sistema no responde: ./riverrun logs backend"
}

# ------------------------------------------------------------------ update
# 1) revisión previa sin tocar lo que corre (código nuevo, imagen construida, configuración, Evolution, respaldo);
# 2) aplicar; 3) verificar; 4) si falla, volver atrás SIN bajar Evolution si ya migró su base (se explica cómo recuperar).
# ------------------------------------------------------------------ update (fases)
# Fases: opciones → código → qué corre hoy → pull (y relanzar si el procedimiento cambió) → revisión previa sin
# arrancar → respaldo → aplicar y verificar → vuelta atrás si algo falla. Las variables UPD_* y EVO_* pasan los datos.
update_args() {
  UPD_BACKUP=1; ACCEPT_DB_IMAGE=0; ACCEPT_EVO=0; UPD_RESUME=""; UPD_PG_BEFORE=""; UPD_FORWARD=(); SKIP_CI=0; UPD_TARGET=""
  # --resume-from/--pg-before: uso interno, cuando el procedimiento se relanza con el riverrun recién descargado.
  local args=("$@") i
  for (( i = 0; i < ${#args[@]}; i++ )); do
    case "${args[$i]}" in
      --no-backup) UPD_BACKUP=0; UPD_FORWARD+=(--no-backup) ;;
      --accept-db-image-change) ACCEPT_DB_IMAGE=1; UPD_FORWARD+=(--accept-db-image-change) ;;
      --accept-evolution-change) ACCEPT_EVO=1; UPD_FORWARD+=(--accept-evolution-change) ;;
      --skip-ci-check) SKIP_CI=1; UPD_FORWARD+=(--skip-ci-check) ;;
      --resume-from) UPD_RESUME="${args[$((i + 1))]:-}"; i=$((i + 1)) ;;
      --pg-before) UPD_PG_BEFORE="${args[$((i + 1))]:-}"; i=$((i + 1)) ;;
    esac
  done
}

# Código: 0 si hay algo que aplicar; 3 si ya está todo al día (sin nada que hacer).
update_fetch() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "Esta instalación no es un repositorio git: descarga la versión nueva y copia tu .env (o clona de nuevo)."
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "Hay archivos modificados a mano: guárdalos (git stash) antes de actualizar."
  UPD_BEHIND=0
  if [[ -n "$UPD_RESUME" ]]; then
    OLD_HEAD="$UPD_RESUME"
    say "Continuando con el procedimiento de actualización nuevo…"
    return 0
  fi
  OLD_HEAD="$(git rev-parse HEAD)"
  git fetch -q origin
  UPD_BEHIND="$(git rev-list --count HEAD..'@{u}')"
  if (( UPD_BEHIND == 0 )); then
    # Sin código nuevo, pero EVOLUTION_IMAGE pudo cambiar en .env: se aplica con el mismo cuidado.
    if ! evo_change_pending; then ok "Ya tienes la última versión ($(version))."; return 3; fi
    say "No hay código nuevo, pero la imagen de Evolution configurada cambió."
  else
    say "${B}Cambios nuevos ($UPD_BEHIND):${N}"; git log --oneline HEAD..'@{u}' | head -n 15 | sed 's/^/  /'; say
    UPD_TARGET="$(git rev-parse '@{u}')"
    update_verify_target "$UPD_TARGET"
  fi
  return 0
}

# INF-4: lo que se va a desplegar se comprueba antes de tocar nada. Si el código viene de GitHub, el commit exacto debe
# tener todas sus comprobaciones de CI terminadas y en verde (las pruebas, las imágenes y los scripts). Con
# UPDATE_ALLOWED_SIGNERS (un archivo de firmantes permitidos que vive FUERA del repositorio), además, la firma del commit.
# --skip-ci-check se salta solo lo del CI, a la vista.
github_repo() {
  [[ -n "${RIVERRUN_GITHUB_REPO:-}" ]] && { echo "$RIVERRUN_GITHUB_REPO"; return 0; }
  local url; url="$(git remote get-url origin 2>/dev/null || true)"
  [[ "$url" =~ github\.com[:/]([^/]+)/([^/]+)$ ]] || return 1
  echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}"
}
update_verify_target() {
  local sha="$1" repo body total status conclusion checked top
  local UPDATE_GITHUB_TOKEN; UPDATE_GITHUB_TOKEN="$(env_get UPDATE_GITHUB_TOKEN)"
  local signers; signers="$(env_get UPDATE_ALLOWED_SIGNERS)"
  if [[ -n "$signers" ]]; then
    [[ -f "$signers" ]] || die "UPDATE_ALLOWED_SIGNERS apunta a $signers, que no existe. No se aplicó nada."
    git -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$signers" verify-commit "$sha" >/dev/null 2>&1 \
      || die "El commit $sha no tiene una firma de alguien en UPDATE_ALLOWED_SIGNERS. No se aplicó nada."
    ok "Firma del commit verificada"
  fi
  if ! repo="$(github_repo)"; then
    warn "El código no viene de GitHub: no se puede comprobar su CI. Revisa los cambios de arriba antes de seguir."
    return 0
  fi
  if (( SKIP_CI )); then
    warn "Se omite la comprobación del CI (--skip-ci-check): se aplica ${sha:0:12} sin saber si sus pruebas pasaron."
    return 0
  fi
  # El CI corre solo cuando cambia la plataforma: se comprueba el último commit del rango que la cambió (es el código
  # que se va a desplegar). Si en el rango no cambió nada de la plataforma, no hay código nuevo que probar.
  top="$(git rev-parse --show-toplevel)"
  checked="$(git log -1 --format=%H "HEAD..$sha" -- . "$top/.github/workflows/${RIVERRUN_CI_WORKFLOW:-ci.yml}")"
  if [[ -z "$checked" ]]; then ok "Los cambios no tocan la plataforma: no hay CI que comprobar"; return 0; fi
  # Solo el flujo de CI (las pruebas, las imágenes y los scripts), no otros flujos que no deciden si se despliega.
  # GitHub corre el CI del último commit de cada push: se busca primero ese (la punta) y, si no tiene corrida, el último
  # commit del rango que cambió la plataforma.
  local cand code out; out="$(mktemp)"
  for cand in "$sha" "$checked"; do
    code="$(curl -sS -o "$out" -w '%{http_code}' --max-time 20 -H 'Accept: application/vnd.github+json' \
      ${UPDATE_GITHUB_TOKEN:+-H "Authorization: Bearer $UPDATE_GITHUB_TOKEN"} \
      "${RIVERRUN_GITHUB_API:-https://api.github.com}/repos/$repo/actions/workflows/${RIVERRUN_CI_WORKFLOW:-ci.yml}/runs?head_sha=$cand&per_page=5" 2>/dev/null || echo 000)"
    case "$code" in
      200) ;;
      404) rm -f "$out"; die "GitHub no encontró el repositorio $repo o su flujo de CI (¿repositorio privado? define UPDATE_GITHUB_TOKEN en .env, con permiso de solo lectura de Actions). No se aplicó nada." ;;
      401|403|429) rm -f "$out"; die "GitHub rechazó la consulta del CI (código $code: límite de consultas o token sin permiso). No se aplicó nada; reintenta en un rato o define UPDATE_GITHUB_TOKEN." ;;
      *) rm -f "$out"; die "No se pudo consultar el CI de ${cand:0:12} en GitHub (¿sin internet?). No se aplicó nada; reintenta, o con --skip-ci-check si es una emergencia." ;;
    esac
    body="$(cat "$out")"
    total="$(printf '%s' "$body" | grep -o '"total_count": *[0-9]*' | head -n 1 | grep -o '[0-9]*$' || echo 0)"
    (( total > 0 )) && { checked="$cand"; break; }
    [[ "$cand" == "$checked" ]] && break
  done
  rm -f "$out"
  (( total > 0 )) || die "El commit ${checked:0:12} no tiene una corrida del CI en GitHub. No se aplicó nada (¿se subió sin pasar por el CI?)."
  # La corrida más reciente es la primera de la lista.
  status="$(printf '%s' "$body" | grep -o '"status": *"[a-z_]*"' | head -n 1 | sed 's/.*"\([a-z_]*\)"$/\1/')"
  conclusion="$(printf '%s' "$body" | grep -o '"conclusion": *\("[a-z_]*"\|null\)' | head -n 1 | sed 's/.*: *"*\([a-z_]*\)"*$/\1/')"
  [[ "$status" == completed ]] || die "El CI de ${checked:0:12} todavía está corriendo. No se aplicó nada: espera a que termine y vuelve a correr ./riverrun update."
  [[ "$conclusion" == success ]] || die "El CI de ${checked:0:12} no está en verde (${conclusion:-sin resultado}). No se aplicó nada."
  ok "CI en verde para ${checked:0:12}"
}

# Lo que corre hoy, antes de tocar nada: qué fallaba, la imagen de backend anterior y Evolution (versión y esquema).
update_snapshot() {
  # Después de actualizar, solo cuenta lo que la versión nueva rompa: se compara contra lo que se pudo medir antes.
  local snap; snap="$(health_snapshot)"
  if [[ -n "$snap" ]]; then
    HEALTH_BEFORE=" $(printf '%s\n' "$snap" | awk '$2 == "fail" { print $1 }' | tr '\n' ' ')"
    HEALTH_MEASURED=" $(printf '%s\n' "$snap" | awk '{ print $1 }' | tr '\n' ' ')"
  else
    HEALTH_BEFORE="?"; HEALTH_MEASURED=""
  fi
  [[ -n "${HEALTH_BEFORE// /}" && "$HEALTH_BEFORE" != "?" ]] && warn "Ya fallaba antes de actualizar:${HEALTH_BEFORE}(no bloquea la actualización)."
  # Guarda la imagen actual para poder volver si la nueva falla.
  PREV_BACKEND="$(dc images -q backend 2>/dev/null | head -n 1 || true)"
  [[ -n "$PREV_BACKEND" ]] && docker tag "$PREV_BACKEND" riverrun-backend:previous
  EVO_BEFORE="$(evo_running_ref)"; EVO_CHANGES=0; EVO_STAYS=0; EVO_ABORT=""; EVO_TARGET=""
  EVO_PIN="$(evo_running_pin)"; EVO_ENV_BEFORE="$(env_get EVOLUTION_IMAGE)"
  if [[ -n "$EVO_BEFORE" ]]; then EVO_MIG_BEFORE="$(evo_db_migration)"; EVO_OPEN="$(evo_open_instances)"; else EVO_MIG_BEFORE="-"; EVO_OPEN=""; fi
  [[ -n "$UPD_RESUME" ]] || UPD_PG_BEFORE="$(pg_image)"
}

# Pull del código. Si el procedimiento mismo cambió, se relanza con el nuevo (lo que corre no se toca hasta entonces).
update_pull() {
  if (( UPD_BEHIND > 0 )); then
    # Exactamente el commit que se comprobó (si main avanzó mientras tanto, eso queda para la próxima).
    git merge -q --ff-only "$UPD_TARGET"
    if ! git diff --quiet "$OLD_HEAD" HEAD -- riverrun; then
      say "El procedimiento de actualización cambió: se continúa con el nuevo."
      exec ./riverrun update --resume-from "$OLD_HEAD" --pg-before "$UPD_PG_BEFORE" "${UPD_FORWARD[@]}"
    fi
  fi
  # Cambiar la imagen de PostgreSQL sobre un volumen existente puede dañar los índices de texto (otra versión de collation):
  # se detiene aquí y se pide hacerlo con el procedimiento de docs/semantic-activation.md.
  local pg_after; pg_after="$(pg_image)"
  if [[ -n "$UPD_PG_BEFORE" && "$UPD_PG_BEFORE" != "$pg_after" && "$ACCEPT_DB_IMAGE" != "1" ]]; then
    abort_update "Esta versión cambia la imagen de PostgreSQL ($UPD_PG_BEFORE → $pg_after). No se aplicó porque un volumen existente puede ser incompatible. Sigue docs/semantic-activation.md (respaldo, ensayo y restauración en un volumen nuevo) o, bajo tu riesgo y con respaldo, repite con --accept-db-image-change."
  fi
}

# Revisión previa: se construye la versión nueva pero no se arranca. Cualquier fallo aquí deja todo como estaba.
update_preflight() {
  export APP_VERSION; APP_VERSION="$(version)"
  say "Construyendo la nueva versión ($APP_VERSION)…"
  # --pull: la imagen base de Node (y la del respaldo) con sus parches de seguridad, no la que quedó en caché (INF-3).
  dc build --pull backend backup || abort_update "No se pudo construir la versión nueva. No se aplicó nada."
  # Redis, Caddy y el convertidor de PDF: se descarga exactamente el digest que fija el compose (los parches llegan como
  # PRs de Dependabot, ya pasados por el CI). Se descargan aquí y se aplican con el resto; PostgreSQL no: cambiar su imagen sobre un volumen existente tiene su propio procedimiento.
  dc pull --quiet redis caddy pdf >/dev/null 2>&1 || warn "No se pudieron descargar las imágenes nuevas de Redis, Caddy o del convertidor de PDF; se sigue con las que hay."
  say "Revisando la configuración con la versión nueva…"
  preflight_config || abort_update "La versión nueva no arrancaría con esta configuración (problemas críticos arriba). Corrígelos en .env y repite ./riverrun update. No se aplicó nada."
  EVO_TARGET="$(evo_target_image)"
  if [[ -n "$EVO_BEFORE" && -n "$EVO_TARGET" && "$EVO_BEFORE" != "$EVO_TARGET" ]]; then
    evolution_preflight || abort_update "$EVO_ABORT"
  fi
  if (( EVO_CHANGES && ! UPD_BACKUP )); then abort_update "Cambiar la versión de Evolution exige un respaldo verificado de sus sesiones: repite sin --no-backup. No se aplicó nada."; fi
}

# Respaldo previo. Con un cambio de Evolution se verifica también su base (BACKUP_VERIFY_ALL).
update_backup() {
  UPD_BACKUP_FILE=""
  (( UPD_BACKUP )) || return 0
  say "Respaldo previo a la actualización…"
  local verify_all=false; (( EVO_CHANGES )) && verify_all=true
  dc exec -T -e BACKUP_VERIFY_ALL="$verify_all" backup /usr/local/bin/backup.sh now || abort_update "El respaldo falló: no se actualiza sin respaldo (usa --no-backup bajo tu riesgo). No se aplicó nada."
  UPD_BACKUP_FILE="$(dc exec -T backup sh -c 'ls -1 /backups/riverrun-*.tar* 2>/dev/null | sort | tail -n 1' 2>/dev/null | tr -d '\r' || true)"
}

# Vuelta atrás. Evolution vuelve a su imagen anterior solo si su esquema no cambió; si ya migró, se queda fijado.
update_rollback() {
  warn "La nueva versión no quedó sana. Volviendo a la anterior…"
  dc logs --tail 30 backend || true
  local evo_mig_after=""
  if (( EVO_CHANGES )); then
    evo_mig_after="$(evo_db_migration)"
    if [[ "$evo_mig_after" != "$EVO_MIG_BEFORE" || "$evo_mig_after" == "?" ]]; then
      # Evolution ya migró su base (o no se puede comprobar que no lo hizo): bajarlo podría dañar las sesiones.
      # Se queda la nueva, fijada para que nada la cambie.
      EVO_STAYS=1
      env_set EVOLUTION_IMAGE "$EVO_TARGET"
    elif [[ -n "$EVO_ENV_BEFORE" ]]; then
      env_set EVOLUTION_IMAGE "$EVO_PIN" # el operador la había fijado en .env: se vuelve a la que corría
    fi
  fi
  # INF-6/INF-7: la versión anterior no conoce la llave de datos ni las credenciales de canales cifradas. Si es así, el
  # código nuevo (que sigue aquí) deja todo en el formato que ella lee antes de volver; si no, se quedaría sin leerlo.
  if ! git cat-file -e "$OLD_HEAD:./src/channel-secrets.ts" 2>/dev/null && git cat-file -e "HEAD:./src/cli/rekey-secrets.ts" 2>/dev/null; then
    say "La versión anterior no lee los secretos cifrados con la llave de datos: se pasan a su formato antes de volver."
    if ! dc run --rm --no-deps -T backend node dist/cli/rekey-secrets.js --to-legacy; then
      warn "No se pudieron pasar los secretos al formato anterior: canales, 2FA o calendarios pueden fallar en la versión anterior."
      warn "  Si pasa, restaura el respaldo previo a la actualización: ./riverrun restore ${UPD_BACKUP_FILE:-<respaldo previo>}"
    fi
  fi
  git reset -q --hard "$OLD_HEAD"
  # La base y Redis vuelven a la configuración anterior (su red y Redis sin contraseña, como los espera la versión
  # anterior): si se quedaran en la red interna o con contraseña, el backend y Evolution de antes no los alcanzarían.
  dc up -d --no-build --no-deps postgres redis || true
  wait_postgres 60 || true
  if [[ -n "$PREV_BACKEND" ]]; then
    restore_backend_image
    APP_VERSION="$(version)" dc up -d --no-build --no-deps backend
  else
    APP_VERSION="$(version)" dc up -d --build
  fi
  if (( EVO_CHANGES && ! EVO_STAYS )); then
    say "El esquema de Evolution no cambió: se vuelve a la imagen anterior (es seguro)."
    APP_VERSION="$(version)" dc up -d --no-deps evolution || true
  fi
  if (( EVO_STAYS )); then
    warn "Evolution se quedó en $EVO_TARGET: ya migró su base ($EVO_MIG_BEFORE → $evo_mig_after) y volver a la imagen anterior podría dañar las sesiones de WhatsApp. No se borró ni se recreó ninguna instancia."
    say "  Se fijó EVOLUTION_IMAGE=$EVO_TARGET en .env para que ningún reinicio la cambie."
    say "  Qué hacer:"
    say "   1. Revisa ./riverrun logs evolution y el panel (Sistema → WhatsApp)."
    say "   2. Si Evolution funciona y lo que falló fue el backend, corrige y vuelve a correr ./riverrun update."
    say "   3. Si Evolution no funciona con esta versión, restaura el respaldo previo (incluye su base y las sesiones):"
    say "      fija EVOLUTION_IMAGE=${EVO_PIN:-<imagen anterior>} en .env y ejecuta ./riverrun restore ${UPD_BACKUP_FILE:-<respaldo previo a la actualización>}"
  fi
  wait_healthy 120 && warn "Volviste a la versión anterior ($(version)). Las migraciones nuevas, si se aplicaron, son compatibles hacia atrás; si ves datos raros: ./riverrun restore latest." || die "No se pudo volver a levantar. Corre ./riverrun restore latest o pide ayuda con los registros (./riverrun logs backend)."
  exit 1
}

# 1 comando, con las fases en orden. La versión nueva se aplica primero para Evolution: tras reiniciarlo, las sesiones
# tardan unos segundos en reconectarse y la salud las vería cerradas.
cmd_update() {
  need_docker || die "Docker no está disponible"
  # Se valida al principio: un valor inválido no debe descubrirse después de haber descargado y respaldado.
  [[ "${RIVERRUN_OBSERVE_SECONDS:-120}" =~ ^[0-9]+$ && "${RIVERRUN_OBSERVE_POLL:-15}" =~ ^[1-9][0-9]*$ ]] \
    || die "RIVERRUN_OBSERVE_SECONDS y RIVERRUN_OBSERVE_POLL deben ser números enteros (poll mayor que 0)."
  update_args "$@"
  local rc=0
  update_fetch || rc=$?
  (( rc == 3 )) && return 0
  update_snapshot
  update_pull
  update_preflight
  update_backup
  # Antes de levantar la versión nueva: así sus contenedores reciben HEALTH_TOKEN. La línea base ya se midió.
  ensure_health_token
  # Usuarios de PostgreSQL por servicio y Redis con contraseña (INF-2). Si fallan, no se aplica nada: la versión
  # anterior sigue funcionando con el superusuario (los objetos que ya cambiaron de dueño no le estorban).
  db_roles || abort_update "No se pudieron crear los usuarios de PostgreSQL (arriba el error). No se aplicó la versión nueva."
  ensure_redis_password
  ensure_data_key || true
  local pbw; pbw="$(panel_bind_warning)"; [[ -z "$pbw" ]] || warn "$pbw"
  if dc up -d --build && wait_healthy 180 && evolution_verify && no_new_failures && observe_window; then
    ok "Actualizado a $APP_VERSION"
    (( EVO_CHANGES )) && ok "Evolution: $EVO_TARGET"
    docker image prune -f >/dev/null 2>&1 || true
    return 0
  fi
  update_rollback
}

# ------------------------------------------------------------------ búsqueda semántica
cmd_semantic() {
  need_docker || die "Docker no está disponible"
  local backup=1
  for a in "$@"; do [[ "$a" == "--no-backup" ]] && backup=0; done
  [[ -n "$(env_get OPENROUTER_API_KEY)" ]] || die "Primero pon OPENROUTER_API_KEY en .env (los embeddings se generan con OpenRouter) y corre ./riverrun restart"
  guard_evolution_change
  if (( backup )); then
    say "Respaldo previo…"
    dc exec -T backup /usr/local/bin/backup.sh now || die "El respaldo falló: no se activa sin respaldo."
  fi
  env_set KNOWLEDGE_SEARCH_ENABLED true
  export APP_VERSION; APP_VERSION="$(version)"
  dc up -d backend
  wait_healthy 120 || die "El sistema no respondió: ./riverrun logs backend"
  say "Comprobando PostgreSQL, pgvector y el proveedor de embeddings…"
  dc exec -T backend node dist/cli/knowledge-activate.js --apply --verify-provider || die "La activación no se completó (revisa el resultado de arriba; ver docs/semantic-activation.md). El asistente sigue funcionando con búsqueda por palabras."
  say "Preparando el conocimiento existente (se repite solo cuando cambia)…"
  dc exec -T backend node dist/cli/knowledge-prepare.js --all --apply || warn "Quedaron documentos por preparar; el sistema los completa solo en segundo plano."
  ok "Búsqueda semántica activada"
}

cmd_logs()    { need_docker || die "Docker no está disponible"; dc logs -f --tail 100 "$@"; }
cmd_restart() {
  need_docker || die "Docker no está disponible"
  guard_evolution_change
  # Un .env con problemas críticos dejaría el backend sin arrancar: se revisa antes de reiniciar lo que funciona.
  preflight_config || die "No se reinició: la configuración tiene problemas críticos (arriba). Corrígelos en .env y repite."
  export APP_VERSION; APP_VERSION="$(version)"; dc up -d; wait_healthy 120 && ok "Funcionando" || die "No respondió: ./riverrun logs backend"
}

# Recupera el acceso del superadministrador: contraseña nueva (se muestra una vez) y sus sesiones cerradas.
cmd_admin_password() {
  need_docker || die "Docker no está disponible"
  [[ -f "$ENV_FILE" ]] || die "No hay .env: primero ./riverrun install"
  local email="${1:-$(env_get ADMIN_USER)}"
  [[ -n "$email" ]] || die "Indica el correo: ./riverrun admin-password tu@correo.com"
  say "Se genera una contraseña nueva para ${B}$email${N} y se cierran todas sus sesiones abiertas."
  dc exec -T backend node dist/cli/admin-password.js "$email" || die "No se cambió la contraseña (¿el sistema está arrancado? ./riverrun status)"
}

# Cambia SESSION_SECRET (firma sesiones y enlaces). Lo cifrado en la base pasa antes a DATA_KEY. Respaldo verificado antes, confirmación
# escrita y el secreto nuevo no se imprime. Consecuencia que se avisa: cierra las sesiones del panel.
cmd_rotate_secret() {
  need_docker || die "Docker no está disponible"
  [[ -f "$ENV_FILE" ]] || die "No hay .env: esta instalación no tiene secretos que cambiar."
  say "${R}${B}Cambiar SESSION_SECRET${N}"
  say "Consecuencias: se cierran todas las sesiones del panel; los enlaces firmados de fotos dejan de funcionar"
  say "(se regeneran solos). Los visitantes del chat web empiezan una conversación nueva (sus sesiones van firmadas)."
  say "Lo cifrado en la base (2FA, Google Calendar, Outlook, credenciales de canales) se pasa antes a la llave de datos"
  say "(DATA_KEY): no hay que volver a conectar nada."
  local sure=""; read -r -p "Escribe ROTAR SESSION_SECRET para continuar (cualquier otra cosa cancela): " sure || true
  [[ "$sure" == "ROTAR SESSION_SECRET" ]] || die "Cancelado: no se cambió nada."
  say "Respaldo verificado antes de cambiar nada…"
  dc exec -T backup /usr/local/bin/backup.sh now || die "El respaldo falló: no se cambia el secreto sin respaldo. No se cambió nada."
  export APP_VERSION; APP_VERSION="$(version)"
  # Sin DATA_KEY todavía: se genera y el backend arranca con ella antes de re-cifrar.
  if ensure_data_key; then
    dc up -d backend
    wait_healthy 120 || die "El backend no respondió con la llave de datos nueva: ./riverrun logs backend. SESSION_SECRET no se cambió."
  fi
  local rk=0; dc exec -T backend node dist/cli/rekey-secrets.js || rk=$?
  (( rk == 0 || rk == 3 )) || die "No se pudieron re-cifrar los secretos con la llave de datos: no se cambió SESSION_SECRET."
  (( rk == 3 )) && warn "Algunos secretos ya no se podían leer desde antes (hay que volver a conectarlos); el resto quedó con la llave de datos."
  local new; new="$(rand 32)"
  env_set SESSION_SECRET "$new"
  dc up -d backend
  wait_healthy 120 || die "El .env ya tiene el secreto nuevo pero el sistema no respondió: ./riverrun logs backend (luego ./riverrun restart). El respaldo previo está en /backups."
  ok "SESSION_SECRET cambiado. Guarda el nuevo fuera del servidor: está en .env (no se muestra aquí)."
  warn "Vuelve a iniciar sesión en el panel."
}

# Cambia DATA_KEY (INF-6): la anterior pasa a DATA_KEYS_OLD (sigue descifrando), el backend arranca con las dos y luego
# se re-cifra todo con la nueva. Respaldo verificado antes; en ningún momento se deja de poder leer lo guardado.
cmd_rotate_data_key() {
  need_docker || die "Docker no está disponible"
  [[ -f "$ENV_FILE" ]] || die "No hay .env: esta instalación no tiene secretos que cambiar."
  say "${R}${B}Cambiar DATA_KEY${N}"
  say "Se vuelven a cifrar el 2FA, los permisos de Google Calendar y Outlook, las llaves de la plataforma y las"
  say "credenciales de los canales. No se cierra ninguna sesión ni hay que volver a conectar nada."
  local sure=""; read -r -p "Escribe ROTAR DATA_KEY para continuar (cualquier otra cosa cancela): " sure || true
  [[ "$sure" == "ROTAR DATA_KEY" ]] || die "Cancelado: no se cambió nada."
  say "Respaldo verificado antes de cambiar nada…"
  dc exec -T backup /usr/local/bin/backup.sh now || die "El respaldo falló: no se cambia la llave sin respaldo. No se cambió nada."
  export APP_VERSION; APP_VERSION="$(version)"
  local old prev; old="$(env_get DATA_KEY)"; prev="$(env_get DATA_KEYS_OLD)"
  env_set DATA_KEY "$(rand 32)"
  # Lo que estaba con la anterior (o con las de antes, o con SESSION_SECRET) se sigue leyendo durante el re-cifrado:
  # ninguna llave anterior se suelta aquí (si una rotación falló a medias, sus filas siguen con la suya).
  [[ -n "$old" ]] && env_set DATA_KEYS_OLD "$old${prev:+,$prev}"
  dc up -d backend
  wait_healthy 120 || die "El backend no respondió con la llave nueva: ./riverrun logs backend. La anterior quedó en DATA_KEYS_OLD (sigue descifrando)."
  local rk=0; dc exec -T backend node dist/cli/rekey-secrets.js || rk=$?
  (( rk == 0 || rk == 3 )) || die "No se pudo re-cifrar todo con la llave nueva; lo guardado se sigue leyendo con DATA_KEYS_OLD. Corrige y vuelve a correr ./riverrun rotate-data-key (no se suelta ninguna llave)."
  if (( rk == 3 )); then
    warn "DATA_KEY cambiada, pero algunos secretos ya no se podían leer con ninguna llave (hay que volver a conectarlos). No borres DATA_KEYS_OLD."
  else
    ok "DATA_KEY cambiada y todo re-cifrado. Guarda la nueva fuera del servidor (está en .env; no se muestra)."
    say "DATA_KEYS_OLD conserva las anteriores: puedes borrarlas de .env después del próximo respaldo."
  fi
}

# ------------------------------------------------------------------ revisión previa a producción (solo lectura)
# No cambia nada y no arranca nada. --offline no sale a internet. Lo que no se puede comprobar aquí (respaldos,
# migraciones, HTTPS) se informa como "no verificado": nunca como aprobado.
PF_BLOCK=0; PF_WARN=0; PF_UNVERIFIED=0
pf_ok()         { ok "$*"; }
pf_warn()       { PF_WARN=$((PF_WARN + 1)); warn "$*"; }
pf_block()      { PF_BLOCK=$((PF_BLOCK + 1)); printf '%s✕%s %s\n' "$R" "$N" "$*"; }
pf_rec()        { printf '%s·%s Recomendación: %s\n' "$B" "$N" "$*"; }
pf_unverified() { PF_UNVERIFIED=$((PF_UNVERIFIED + 1)); printf '%s?%s No verificado: %s\n' "$Y" "$N" "$*"; }

pf_online() {
  local domain="$1" snap code
  if need_docker && [[ -n "$(dc ps -q backend 2>/dev/null)" ]]; then
    snap="$(health_snapshot)"
    if [[ -z "$snap" ]]; then pf_block "El backend no responde a su comprobación de salud (./riverrun logs backend)."
    elif printf '%s\n' "$snap" | grep -q ' fail$'; then pf_warn "Comprobaciones en falla: $(printf '%s\n' "$snap" | awk '$2 == "fail" { printf "%s ", $1 }')(./riverrun status)."
    else pf_ok "Servicios en marcha sin fallos"; fi
  else
    pf_unverified "servicios en marcha (no están levantados: ./riverrun status)"
  fi
  if [[ -n "$domain" && "$domain" != "localhost" ]] && command -v curl >/dev/null 2>&1; then
    code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "https://$domain/health" 2>/dev/null || echo 000)"
    if [[ "$code" == "200" ]]; then pf_ok "HTTPS responde en https://$domain/health"; else pf_warn "https://$domain/health no responde 200 (código $code): revisa el DNS y el certificado."; fi
  else
    pf_unverified "HTTPS público (requiere un dominio y curl)"
  fi
}

cmd_preflight() {
  local offline=0 a
  for a in "$@"; do
    case "$a" in
      --offline) offline=1 ;;
      *) die "Opción desconocida: $a (uso: ./riverrun preflight [--offline])" ;;
    esac
  done
  say "${B}Revisión previa a producción${N}$( (( offline )) && echo ' (sin red)' || true):"
  PF_BLOCK=0; PF_WARN=0; PF_UNVERIFIED=0

  # Máquina. /proc y df se pueden fijar con RIVERRUN_PREFLIGHT_* (las usan las pruebas).
  if need_docker; then pf_ok "Docker y Compose disponibles"; else pf_block "Docker o Docker Compose no están disponibles: instálalos antes de publicar."; fi
  local mem_kb disk_kb cpus mem_mb disk_gb
  mem_kb="${RIVERRUN_PREFLIGHT_MEM_KB:-$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null || true)}"
  disk_kb="${RIVERRUN_PREFLIGHT_DISK_KB:-$(df -Pk . 2>/dev/null | awk 'NR == 2 { print $4 }' || true)}"
  cpus="${RIVERRUN_PREFLIGHT_CPUS:-$(nproc 2>/dev/null || true)}"
  if [[ "${mem_kb:-0}" =~ ^[0-9]+$ ]] && (( ${mem_kb:-0} > 0 )); then
    mem_mb=$(( mem_kb / 1024 ))
    if (( mem_mb < 1024 )); then pf_block "Memoria: ${mem_mb} MB. Con menos de 1 GB no caben PostgreSQL y Evolution."
    elif (( mem_mb < 1800 )); then pf_warn "Memoria: ${mem_mb} MB. Funciona, pero deja poco margen en un VPS de 2 GB (límites en docs/produccion.md)."
    else pf_ok "Memoria: ${mem_mb} MB"; fi
  else
    pf_unverified "memoria (no se pudo leer /proc/meminfo)"
  fi
  if [[ "${disk_kb:-0}" =~ ^[0-9]+$ ]] && (( ${disk_kb:-0} > 0 )); then
    disk_gb=$(( disk_kb / 1048576 ))
    if (( disk_gb < 2 )); then pf_block "Disco libre: ${disk_gb} GB. Los respaldos y las subidas van a fallar."
    elif (( disk_gb < 5 )); then pf_warn "Disco libre: ${disk_gb} GB (recomendado: 5 GB o más)."
    else pf_ok "Disco libre: ${disk_gb} GB"; fi
  else
    pf_unverified "disco (no se pudo leer el espacio libre)"
  fi
  if [[ "${cpus:-0}" =~ ^[0-9]+$ ]] && (( ${cpus:-0} < 2 )); then pf_rec "1 CPU: la IA y los respaldos compiten con la atención de mensajes. Lo recomendado son 2."; fi

  # Configuración
  if [[ -f "$ENV_FILE" ]]; then
    pf_ok "Archivo .env presente"
    local perm; perm="$(stat -c %a "$ENV_FILE" 2>/dev/null || stat -f %Lp "$ENV_FILE" 2>/dev/null || echo '?')"
    case "$perm" in
      600|400) pf_ok "Permisos de .env: $perm" ;;
      '?') pf_unverified "permisos de .env" ;;
      *) pf_warn "Permisos de .env demasiado abiertos ($perm). Corrígelos con: chmod 600 .env" ;;
    esac
  else
    pf_block "Falta .env: instala con ./riverrun install."
  fi
  if need_docker && [[ -f "$ENV_FILE" ]]; then
    if preflight_config; then
      if (( CFG_VERIFIED )); then pf_ok "Configuración: sin problemas críticos"
      else pf_unverified "configuración: el backend no pudo ejecutar la revisión (./riverrun logs backend)"; fi
    else
      pf_block "Configuración con problemas críticos: corrígelos (lista arriba) antes de publicar."
    fi
    if dc config -q >/dev/null 2>&1; then pf_ok "docker-compose.yml válido con el .env actual"; else pf_block "docker-compose.yml no es válido con el .env actual (variables obligatorias faltantes: ./riverrun status)."; fi
  else
    pf_unverified "configuración y docker-compose.yml (requieren Docker y .env)"
  fi

  local domain mode evo_img
  domain="$(env_get DOMAIN)"; mode="$(env_get OUTBOUND_MODE)"
  if [[ -z "$domain" || "$domain" == "localhost" ]]; then pf_warn "Sin dominio público (DOMAIN=${domain:-vacío}): todavía no es un servidor de producción."
  else pf_ok "Dominio: $domain"; fi
  if [[ "$mode" == "sandbox" ]]; then pf_warn "OUTBOUND_MODE=sandbox: los envíos reales están bloqueados (correcto en pruebas; en producción debe ser live)."
  else pf_ok "Envíos reales habilitados (OUTBOUND_MODE=${mode:-live})"; fi
  # Alertas fuera del panel: sin ellas una falla de noche pasa inadvertida.
  if [[ -n "$(env_get SMTP_URL)" && -n "$(env_get SUPERADMIN_EMAIL)" ]]; then pf_ok "Alertas por correo (SMTP_URL y SUPERADMIN_EMAIL)"
  elif [[ -n "$(env_get ALERT_WEBHOOK_URL)" ]]; then pf_warn "Sin correo (SMTP_URL): las alertas salen solo por ALERT_WEBHOOK_URL y los avisos al equipo solo por el panel y WhatsApp."
  else pf_warn "Ninguna alerta sale del servidor: define SMTP_URL (correo) o ALERT_WEBHOOK_URL (Slack, Discord, ntfy)."; fi
  if [[ -n "$(env_get HEARTBEAT_URL)" ]]; then pf_ok "Latido externo configurado (HEARTBEAT_URL)"
  else pf_warn "Sin HEARTBEAT_URL: si el servidor completo se cae, nadie avisa (crea un chequeo en healthchecks.io)."; fi
  local pb; pb="$(panel_bind_warning)"
  if [[ -n "$pb" ]]; then pf_warn "$pb"; else pf_ok "El panel solo escucha en el propio servidor (PANEL_BIND)"; fi
  if [[ -f "${RIVERRUN_PREFLIGHT_ETC:-/etc}/riverrun-harden" ]]; then pf_ok "Servidor endurecido (./riverrun harden)"
  else pf_warn "El servidor no se ha endurecido: sudo ./riverrun harden (firewall, SSH solo con llave, fail2ban, actualizaciones)."; fi
  if [[ -n "$(env_get HEALTH_TOKEN)" ]]; then pf_ok "HEALTH_TOKEN definido (/health/functional y /metrics activos)"
  else pf_warn "HEALTH_TOKEN vacío: /health/functional y /metrics no existen. Lo genera ./riverrun update."; fi

  # Versiones
  if need_docker && [[ -f "$ENV_FILE" ]]; then evo_img="$(evo_target_image || true)"; else evo_img=""; fi
  if [[ "$evo_img" == *@sha256:* ]]; then pf_ok "Evolution fijada por digest"
  elif [[ -n "$evo_img" ]]; then pf_warn "Evolution no está fijada por digest ($evo_img): una actualización puede cambiarla sin aviso."
  else pf_unverified "imagen de Evolution (requiere Docker y .env)"; fi

  # Lo que exige servicios en marcha, red o el contenedor de respaldos: se informa, no se da por bueno.
  pf_unverified "último respaldo y su copia en la nube (./riverrun status)"
  pf_unverified "migraciones de la base de datos pendientes (requieren PostgreSQL en marcha)"
  if (( offline )); then pf_unverified "certificado HTTPS y DNS (revisión en línea: ./riverrun preflight sin --offline)"
  else pf_online "$domain"; fi

  say ""
  if (( PF_BLOCK > 0 )); then
    printf '%s✕ Estado final: BLOQUEADO%s: %d bloqueo(s), %d advertencia(s), %d sin verificar. Corrige los ✕ antes de publicar.\n' "$R" "$N" "$PF_BLOCK" "$PF_WARN" "$PF_UNVERIFIED"
    return 1
  fi
  if (( PF_WARN > 0 )); then say "${Y}!${N} Estado final: APROBADO CON ADVERTENCIAS: $PF_WARN advertencia(s), $PF_UNVERIFIED sin verificar."
  elif (( PF_UNVERIFIED > 0 )); then say "Estado final: SIN BLOQUEOS EN LO REVISADO: quedan $PF_UNVERIFIED comprobación(es) sin verificar (marcadas con ?). No es una aprobación completa."
  else say "${G}✓${N} Estado final: APROBADO."
  fi
  return 0
}

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

case "${1:-help}" in
  install) shift; cmd_install "$@" ;;
  install-docker) cmd_install_docker ;;
  update) shift; cmd_update "$@" ;;
  status) cmd_status ;;
  backup) cmd_backup ;;
  restore) shift; cmd_restore "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  restart) cmd_restart ;;
  rotate-secret) cmd_rotate_secret ;;
  rotate-data-key) cmd_rotate_data_key ;;
  db-roles) cmd_db_roles ;;
  admin-password) shift; cmd_admin_password "$@" ;;
  keys) shift; cmd_keys "$@" ;;
  harden) shift; cmd_harden "$@" ;;
  preflight) shift; cmd_preflight "$@" ;;
  semantic) shift; cmd_semantic "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
