{
  "name": "chatbot-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de chatbots de WhatsApp (Evolution API + OpenAI) totalmente configurable",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/cli/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
