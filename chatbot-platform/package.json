{
  "name": "chatbot-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de chatbots de WhatsApp (Evolution API + OpenAI) totalmente configurable",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/cli/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "user:master": "tsx --env-file-if-exists=.env src/cli/grant-master.ts",
    "user:admin-password": "tsx --env-file-if-exists=.env src/cli/admin-password.ts",
    "eval": "npm run build && PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=/tmp/riverrun-promptfoo promptfoo eval -c evals/promptfooconfig.yaml --no-cache --max-concurrency 1",
    "eval:live": "npm run build && RIVERRUN_EVAL_LIVE=true PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=/tmp/riverrun-promptfoo node --env-file-if-exists=.env node_modules/promptfoo/dist/src/entrypoint.js eval -c evals/live.yaml --no-cache --max-concurrency 1",
    "knowledge:check": "tsx --env-file-if-exists=.env src/cli/knowledge-activate.ts",
    "knowledge:activate": "tsx --env-file-if-exists=.env src/cli/knowledge-activate.ts --apply --verify-provider",
    "knowledge:prepare": "tsx --env-file-if-exists=.env src/cli/knowledge-prepare.ts",
    "eval:engine": "npm run build && node scripts/eval-engine.mjs",
    "eval:engine:live": "npm run build && node --env-file-if-exists=.env scripts/eval-engine.mjs --live",
    "eval:copilot": "node --import tsx scripts/eval-copilot.mts --simulado",
    "eval:copilot:live": "node --env-file-if-exists=.env --import tsx scripts/eval-copilot.mts",
    "config:check": "tsx --env-file-if-exists=.env src/cli/config-check.ts",
    "evolution:check": "tsx --env-file-if-exists=.env src/cli/evolution-check.ts",
    "operations:check": "tsx --env-file-if-exists=.env src/cli/operations-check.ts",
    "check:frontend": "node scripts/check-frontend.mjs",
    "test:ux": "node --import tsx scripts/test-ux.mts",
    "test:semantic:ux": "node --import tsx scripts/test-semantic-ux.mts",
    "test:agent:ux": "node --import tsx scripts/test-agent-quality-ux.mts",
    "test:contact:ux": "node --import tsx scripts/test-contact-budget-ux.mts",
    "test:quotes:ux": "node --import tsx scripts/test-quotes-ux.mts",
    "test:billing:ux": "node --import tsx scripts/test-billing-ux.mts",
    "test:public:ux": "node --import tsx scripts/test-public-ux.mts",
    "test:buttons": "node --import tsx scripts/test-buttons.mts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.5",
    "docxtemplater": "^3.71.1",
    "fastify": "^5.6.0",
    "imapflow": "^2.2.6",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.0",
    "pizzip": "^3.3.0",
    "qrcode-generator": "2.0.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "axe-core": "4.11.0",
    "playwright": "1.58.2",
    "promptfoo": "0.124.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
