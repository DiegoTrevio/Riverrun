# HTTPS automático para el panel y el webhook. Define DOMAIN en .env
{
	# Marca blanca: el certificado de un dominio de cliente solo se pide si está registrado en una marca.
	on_demand_tls {
		ask http://backend:3000/internal/domain-ok
	}
}

# Siempre por HTTPS (un año) y sin anunciar el servidor. Sin includeSubDomains: DOMAIN puede ser el dominio del negocio y
# sus otros subdominios no son nuestros. Los demás encabezados (CSP, iframes, nosniff) los pone el backend.
(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$DOMAIN} {
	encode gzip
	import seguridad
	# /internal/* es solo para Caddy (va directo al backend, sin pasar por aquí)
	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy backend:3000
	}
}

# Dominios propios de marcas (panel.miagencia.com): el cliente apunta un registro DNS a este servidor.
https:// {
	tls {
		on_demand
	}
	encode gzip
	import seguridad
	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy backend:3000
	}
}
